/build/
/.deps/
/dist/
# Both forms, deliberately. `/vendor/` alone matches only a DIRECTORY,
# so a SYMLINK named `vendor` -- which is what you get from `ln -s
# /Users/.../maux/vendor vendor` in a scratch worktree -- slips straight
# past it and `git add -A` commits it as a mode-120000 blob. Merging that
# into main then replaces the real (ignored) vendor directory with a
# self-referential symlink and the build inputs vanish. Happened
# 2026-08-24; recovered from copies surviving in stream worktrees.
/vendor/
/vendor
__pycache__/
*.pyc

# generated by scripts/build_rel_image.py
src/relspike/RTNAMES#068000
src/relspike/.a2til-mirror.json
.claude/worktrees/

# merlin32 writes a _FileInformation.txt sidecar beside every source it
# assembles, recording the ProDOS type/auxtype it would give the output.
# 48 Makefile rules already `rm -f` it by hand and a few do not, so it
# reappears in `git status` after those targets and gets swept into an
# unrelated commit by anyone using `git add -A`. It is generated, never
# read by this build, and belongs nowhere near the index.
_FileInformation.txt

# merlin32 writes the object beside the source (the rule cd's into
# src/test), so these are build droppings, not sources.
src/test/asmodtest
src/test/asmultitest
src/test/_FileInformation.txt
build/iobuf/

# check-nas's oracle (docs/AS-PLASMA.md): merlin32 assembles
# src/test/asm/fixture.s in place (no dsk directive), so the object
# and listing land beside the source before the Makefile rule moves/
# removes them. Build droppings, not sources.
src/test/asm/fixture
src/test/asm/fixture_Output.txt

# A 465 MB whisper model (ggml-small.en.bin) appeared untracked in the repo
# root on 2026-09-19 -- not a project input, nothing in the tree references
# it, and `git add -A` would have written it into history permanently. It is
# ignored rather than deleted so the operator can move it where it belongs.
ggml-small.en.bin
*.ggml
