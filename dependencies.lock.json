    "ffmpeg": {
      "comment": "OPTIONAL, test tier only (tiers.test.optional_tools). Only `make demos` encodes (scripts/demo_record.py --record); no sweep does, and the Linux box has none. Absent is fine; if it is on PATH, check-deps requires it to meet this floor and have these encoders and filters, so a half-capable build is named before a recording fails. min is the version the recorder's numbers were measured on (docs/RECORDER-NOTES.md sec 3). scripts/ffmpeg_probe.py reads this block for both check-deps and demo_record.py; neither carries its own copy.",
      "min": [9, 0],
      "encoders": ["libx264", "libvpx-vp9"],
      "filters": ["scale", "split", "format"],
      "needed_by": "make demos"
    },
    "required_commands": ["git", "make", "cc", "c++"]
  },
