  "python_packages": {
    "a2til": {
      "comment": "The build tier installs this into a project-local venv with pip --require-hashes --only-binary :all:. A version alone is not a pin; the hash is. Either file is accepted; the wheel is what installs. source_commit is the GitHub pin the release was cut from (the GitHub 0.9.0 tag); the sdist is that commit's tree plus PKG-INFO (checked 2026-10-19). If the host's Python has no pip (Debian without python3-venv), the wheel is downloaded from its url, held to bytes and sha256 here, and unzipped into the venv. If PyPI is unreachable, bootstrap falls back to git_url@source_commit and check-deps holds the result to installed_manifest_sha256, the hash of the installed a2til/ files, which is the same for both routes (measured 2026-10-19).",
      "version": "0.9.0",
      "files": [
        {"filename": "a2til-0.9.0-py3-none-any.whl", "url": "https://files.pythonhosted.org/packages/29/e3/3088c861601ab110a9522cb91b385eac6fc5664b7836b235987e067dcc6d/a2til-0.9.0-py3-none-any.whl", "bytes": 162825, "sha256": "f88bebae7c7c1ff56a471653ca46aece712a2b0347aeb2d1a2ac4bdcb621c723"},
        {"filename": "a2til-0.9.0.tar.gz", "url": "https://files.pythonhosted.org/packages/2f/91/0f27ac0c99890f78236b5a1212f4b3d059596a9b2197fb76f7d28ffc8efb/a2til-0.9.0.tar.gz", "bytes": 369980, "sha256": "f3ffd045168ca26f0c8177af2bc04c2e5f7c4f90ba84b273d91f653ee8132a8b"}
      ],
      "source_commit": "3a9e88eeb3857c19c1a68b8ae1ceea3c4c74dceb",
      "git_url": "https://github.com/emdeejay/a2til.git",
      "installed_manifest_sha256": "8f754d4c23496d3bee64a3dead5d7d524732ea5e6369bcd88f1cc18df564bc22"
    }
  },
  "tools": {
    "acme": "release 0.97",
    "merlin32": "v1.1.10",
