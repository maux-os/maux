//
def buildputpath(namep, oplen)#1
    // PLASMA strings are LENGTH-PREFIXED (byte 0 = length, no NUL
    // terminator -- confirmed against vmsrc/cmdsys.c's sysstrcpy:
    // `memcpy(dst, src, mem_6502[src] + 1)`), the SAME convention
    // objpath/srcpath already use via strcpy(). This function wrote
    // a C-string on its first pass (text starting at offset 0, a
    // trailing $00) and fileio:open/puts both read byte 0 as a
    // LENGTH instead -- 'r' ($72=114) as "114 characters follow",
    // which walked off the end of putpath into objpath/srcpath and
    // printed their contents back as "garbage". Measured directly
    // (PUTDBG instrumentation, task report) before this fix.
    word i, pl
    byte dot
    dot = 0
    i = 0
    while i < oplen and i < 62
        ^(@putpath + 1 + i) = ^(namep + i)
        if ^(namep + i) == '.'
            dot = 1
        fin
        i++
    loop
    pl = i
    if not dot
        ^(@putpath + 1 + pl) = '.'
        pl++
        ^(@putpath + 1 + pl) = 'S'
        pl++
    fin
    ^(@putpath) = pl
    return pl
end
def isputline()#1
    if g_mnemlen == 0 or g_operlen == 0
        return 0
    fin
    if matchdir(g_mnemptr, g_mnemlen, @dirPUT, 3)
        return 1
    fin
    if matchdir(g_mnemptr, g_mnemlen, @dirUSE, 3)
        return 1
    fin
    return 0
end
//
// ---- L3 reader -------------------------------------------------------
//
def rdrefill(slot)#0
    word n
    if slot == 0
        n = fileio:read(rd_ref0, rd_buf0, RDBUFSZ)
        rd_fill0 = n
        rd_pos0 = 0
    else
        n = fileio:read(rd_ref1, rd_buf1, RDBUFSZ)
        rd_fill1 = n
        rd_pos1 = 0
    fin
end
// rdgetline -- next $0D/$8D-delimited line of one file into linebuf;
