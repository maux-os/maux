// -1 for an unrecognized opcode/mode combination. noteinst uses the
// same opcode-to-mode table as pass 2 to recover size and fixup need.
//
def isquoteitem(p, l)#1
    if l >= 2 and (^p == '"' or ^p == $27) and ^(p+l-1) == ^p
        return 1
    fin
    return 0
end
def nextitem(p, l, start)#3
    word i
    byte instr, delim
    i = start
    instr = 0
    while i < l
        if instr
            if ^(p+i) == delim
                instr = 0
            fin
        elsif ^(p+i) == '"' or ^(p+i) == $27
            delim = ^(p+i)
            instr = 1
        elsif ^(p+i) == ','
            return start, i - start, i + 1
        fin
        i++
    loop
    return start, i - start, i + 1
end
//
// emititem -- emit one list item to a NONZERO destination and return
// its byte count. listwalk handles destination-free sizing itself. A
// quoted item under LK_DFB/LK_DA/LK_DDB contributes only its first
// char's code (measured: `dfb "AB",$00` -> C1 00); under LK_ASC it
// expands every character (measured: `asc "AB",$00` -> C1 C2 00).
//
def emititem(p, l, dest, kind)#1
