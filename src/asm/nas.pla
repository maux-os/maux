            return 2
        elsif kind == LK_DDB
            ^dest = (v >> 8) & $FF
            ^(dest+1) = v & $FF
            return 2
        else
            ^dest = v & $FF
            if relflag and kind == LK_DFB and g_ek
                relpatch(dest, 1, g_ek, g_ern, g_esel, g_eraw)
