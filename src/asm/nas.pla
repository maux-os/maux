word      = 1,1
//
// ---- CONSTANT DATA ENDS HERE. plascut --const-prefix NAS finds this
// 4-byte mark in the data segment and keeps a pristine copy (for the
// warm respawn) only of what follows: every table above is read-only
// and was being copied twice into the cooked image (2026-09-15).
// Declare constants ABOVE this line, mutable globals below.
word mutmark = $5AA5, $C33C
//
word symtail, modehead, modepage, errtail, retrytail
word symrec      // first stable record; next link at record + SYMRSZ
// Unused legacy layout slots retained during byte-identical promotion.
word symnext
word namearena
word nameused
word namecap
word numsyms
word maxsyms
//
// Hash index over the symname/symval/... slots above (AS-PLASMA.md
// sec 3/sec 7 -- the operator's "hash vs MRU-scan, measured not
// asserted" question, now resolved by measurement, docs/AS-PROFILE.md
// BEFORE/AFTER table). The parallel arrays and their slot indices are
// UNCHANGED -- this is a separate chained index INTO them, nothing
// more: hashhead[h] is the most-recently-added slot hashing to bucket
// h (or -1, empty), hashnext[slot] is the next-older slot in the same
// bucket (or -1, chain end). findsym/addsym below are the only two
// places that touch it.
//
// HASHSIZE -- power of two, bucket = hash & (HASHSIZE-1). MEASURED
// (task report, docs/AS-PROFILE.md hash section) down from an initial
// 512: nas's heap (maux's per-process aux bank via sbrk, NOT the host)
// was already thin enough that prof.large.s (438 lines/106 symbols)
// ran within roughly a hundred bytes of exhaustion even in the OLD
// O(n)-scan build (see the fixup-array note in run(), the OTHER half
// of this fix). 512's 1024-byte hashhead alone pushed it over, and
// heapalloc's failure return (0) went unchecked, so pass2's objbuf
// silently got a NULL pointer and scribbled zero page -- garbled
// object bytes, no error, no crash. 128 buckets (256 bytes) plus the
// deferred fixup arrays together restore comfortable headroom, and
// 128 still gives well under 1 average chain hop at maux's real
// symbol counts (AS-PLASMA.md sec 3).
const HASHSIZE = 128
word hashhead    // heap ptr, word/slot -- hashhead=>[h], HASHSIZE slots
//
// L1b REL symbol-table extensions (parallel arrays, same index as
// symname/symval/symdef). symkind distinguishes a RELOCATABLE label
// (0, the default -- a curpc-derived address, address-valued, must
// shift when the module links at a nonzero base) from an EQU
// CONSTANT (1, an assembly-time value that never relocates) --
// MEASURED against merlin32: a REL module forces ABSOLUTE addressing
// for any operand touching a label, even one whose module-relative
// value is <=255, but still chooses ZP for an EQU constant of the
// same value (see decidemode's relflag branch and the task report).
//
word numexts     // next EXT refnum to assign (0-based, declaration order)
word numents     // ENT declarations seen (sizes the dictionary write)
//
// L2 DUM/DEND state (task #21). dumflag is 1 while inside a DUM
// block; dumsave holds the REAL location counter as it stood the
// instant DUM opened (evaluated BEFORE curpc is overwritten, so a
// `dum *` -- liba/libabss.s's own idiom -- captures the pre-DUM pc,
// not the post-DUM one). DEND sets curpc back to dumsave. MEASURED
// against merlin32 v1.1.10 (task report): every line processed while
// dumflag is set (labels, DS/DFB/ASC/HEX/DCI/STR/DA/DDB, even a real
// opcode) still advances the (now DUM-relative) curpc and still binds
// any label to that address, but contributes ZERO bytes to the
// object -- pass1's dispatch forces such a line's `linetype` to
// T_NONE (T_EQU/T_ERR excluded: an EQU or ERR line inside a DUM block
// behaves exactly as it would outside one, unaffected by DUM's
// virtual pc -- also measured).
//
byte dumflag
word dumsave
// dumabs -- 1 while inside a DUM whose ORIGIN is a constant (`dum
// $FF00`, mm.procbnk2.equ's page): its labels are absolute
// addresses and must be CONSTANTS (symkind 1) in a REL module. Found
// by the roster sweep (ex/vi, 2026-09-13): `lda BANK_ID` against a
// $FF00-block cell came out RELOCATED by the module base, because a
// dum label was a plain label and classifyoperand made a fixup of it.
// A `dum *` / `dum LABEL` origin is relocatable and its labels stay
// so (libabss's own arena idiom).
byte dumabs
//
// `:local` label support (task #21, docs/AS-PLASMA.md; merlin32 is the
// sole oracle -- see the task report for the empirical probe). merlin32
// v1.1.10, measured directly (scratchpad tests, NOT the commons'
// blanket "whole-file uniqueness" claim taken on faith): a ZONE is the
// span from one GLOBAL (non-`:`) label to the next (ANY label-bearing
// line opens a new zone, regardless of directive -- EQU included). A
// `:name` defined in exactly ONE zone file-wide behaves like a plain
// global (merlin32 internally renames it `_name`) and resolves from
// ANY zone -- this is the real "whole-file uniqueness" case, and it is
// why findsym/addsym below need NO change for the common case: the
// raw colon-prefixed text is already a file-unique hash key. A `:name`
// defined in MORE THAN ONE zone is different: merlin32 assigns each
// zone's own definition a distinct internal id (`ozunid_N`) and binds
// ONLY that zone's own references to it; a reference to an AMBIGUOUS
// name from a zone that has no definition of its own is a merlin32
// ERROR ("Impossible to decode address mode") -- out of this file's
// scope (see the task report), left as an unresolved reference here
// (matches nas's existing behavior for any other undefined symbol).
//
// symzone/curzone implement the zone-scoped half: -1 is the WILDCARD
// (a global label, or an unambiguous local) and matches any query
// zone; a concrete zone value must match the query zone exactly. See
// reszone() below -- findsym/addsym call it internally, so every
// existing call site (pass1, pass2, the EQU retry loop) is unchanged
// text; only their INTERNAL behavior for a `:name` differs.
//
word curzone     // the CURRENT line's zone, counted at global labels
//
// Local-name ambiguity index, built as pass 1 meets definitions.
// Each 6-byte record holds FIRST symbol pointer, FIRST zone, chain
// link. Names share the main symbol's packed name; its zone is -1
// until a second definition zone pins it (the ambiguity flag).
// Heads grow to the next power of two, capped at HASHSIZE. Including
// heads, at most 10 bytes/local replace the old 19 bytes/local.
// An input with no locals retains just one empty two-byte head.
word lochead     // heap ptr, word/bucket; zero terminates each chain
word locmask     // bucket count - 1 (same raw hash as the main table)
word locnext     // next free 6-byte record
word numlocs
word maxlocs
//
// L3 STREAMING (docs/AS-STREAM.md, 2026-09-14): nothing per line is
// kept. The source is read twice (locate, emit), PUT/USE folded into
// the reader; the one pass-1 decision pass 2 cannot re-derive -- the
// addressing MODE of an operand that was forward at the time -- is a
// opcode byte per code line (the mode stream); EQU lines that evaluated
// unresolved or through a provisional symbol go on a small retry
// list, ERR lines on a deferred list; the object streams to disk
// through a 512 B buffer. What was 15 B/line + the whole spliced
// closure (115 KB for pwd, 3-6x the heap for a kernel module) is now
// ~2.5 KB of buffers + the mode stream (1 byte/code line).
//
word numlines    // CONTENT lines seen by the last pass (diagnostics,
                 // and the EQU retry's iteration bound)
//
// lineprep classifies the parsed mnemonic once per line. D_CODE (0)
// means not a directive: either an opcode or a label-only line.
//
//
// ---- the reader: two block buffers (top-level file, PUT file), one
// line buffer. rd_inputt is 1 while lines come from the put file;
// rd_pendput is armed by rdnoteput() when the line just parsed was a
// top-level PUT/USE (the line itself is returned unchanged -- pass
// 1's dirPUT branch sizes it to zero as before) and the NEXT srcline()
// opens the file. A PUT/USE line met INSIDE a put file is inert
// (single-level, the measured merlin32 rule).
//
const RDBUFSZ = 512
const LINEMAX = 256
word rd_buf0, rd_pos0, rd_fill0      // slot 0 state: CONTIGUOUS (lineprep)
word rd_buf1, rd_pos1, rd_fill1      // slot 1 state (the PUT file)
word rd_buf2, rd_pos2, rd_fill2      // slot 2: an EMPTY slot, so a
                                     // pending PUT misses the fast path
word rd_ref0, rd_ref1
byte rd_inputt   // the slot's OFFSET from rd_buf0: 0, 6 (in a put) or
                 // 12 (a put is pending); nonzero = "inside a put"
byte rd_pendput
word linebuf     // only a line that straddles a block boundary is copied
word g_line      // the line srcline() last returned (in the block buffer,
                 // or linebuf when it straddled)
word rd_linelen  // its length
word g_lineno    // ordinal over the whole expanded stream, identical
                 // in every pass (the reader is deterministic)
//
// ---- the mode stream: one opcode byte per CODE line, in pass-1 order.
//
word modestrm    // heap, one byte per code line: the OPCODE pass 1
                 // chose (its mode via opmode, so pass 2 never
                 // searches the table again)
word modecnt     // bytes appended (pass 1)
word modepos     // bytes consumed (pass 2)
word maxmodes    // current replay page capacity (256)
//
// ---- EQU retry list (pass 1): only EQUs whose evaluation was
// unresolved or TAINTED (read a provisional symbol -- g_prov, set by
// evalterm2 when findsym returns a symbol flagged symprov). The tree's
// sources assemble under real Merlin-8, which refuses a forward EQU
// reference, so in practice this holds the stress fixture's chain
// and nothing else; the cap is loud, not silent.
//
const RETRYMAX = 16
const RETRYREC = 72          // idx:2 star:2 zone:2 len:1 text:<=65
word retry       // first linked record; next at record - 2
word numretry
byte g_prov      // raised by evalterm2 on a provisional symbol read
//
// ---- deferred ERR list (pass 1): linked actual-size allocations.
//
word errlist     // heap: per entry star:2 zone:2 len:1 text
word errbytes    // unused legacy layout slot
word numerrs
word errfill     // bytes used
//
// ---- the streamed object (pass 2).
//
const OUTBUFSZ = 512
word outbuf
word outfill
word outtotal    // bytes written (the "N bytes ->" report)
// CONTIGUOUS commitinst state: buf,fill,total,pc,nfixcand,orgbase.
word curpc
word nfixcand    // CONTIGUOUS with curpc: noteinst updates both.
word orgbase
word outref
word linebytes   // heap LINEMAX: one line's emission before outwrite
byte outopen
//
// Assembly state.
//
byte orgset
word curstar     // '*' term value for the line CURRENTLY being evaluated
word objhigh
byte errflag
byte xcflag      // 65C02 opcodes/modes enabled once `xc` is seen
//
// One-lookup-per-line opcode cache (docs/AS-PROFILE.md $F2 finding),
// PLASMA-tightening pass ($F2 histogram: fillmodes was 24-27% of
// on-process cost, mostly the unconditional 15-slot init+gather it
// did on EVERY line even though decidemode queries only a handful of
// modes). fillmodes() (called once, at the top of decidemode) still
// does the ONE binary search into optab (sorted by mnemonic at
// startup, sortoptab(), run()) -- but now it just records the
// mnemonic's contiguous row-BLOCK bounds [g_blo, g_bhi] (a mnemonic
// has at most ~9 rows, e.g. ADC/AND/AND/CMP/EOR/LDA/ORA/SBC's 9 modes
// each). modeprobe() scans that tiny block directly for the asked mode
// -- no 15-slot array, no unconditional gather of modes nobody asks
// for. g_blo=1/g_bhi=0 (an empty range) is the "mnemonic not found"
// sentinel: the scan loop below never executes, so modeprobe() falls
// straight through to its "not supported" return with no extra check.
//
word g_blo
word g_bcnt      // rows in the block
word g_bhi
word g_bptr      // pointer to the block's first row (optab + g_blo*6)
word g_bend      // pointer to the block's last row
word g_bits      // the mnemonic's mode BITMAP (1 << mode), 0 if unknown
//
// Mnemonic lookup by HASH (2026-09-14): a 256-bucket table of block
// starts over the sorted optab (mnhead), chained through mnnext, with
// each block's end (mnend) and mode bitmap (mnbits) precomputed once.
// The binary search (8 probes x 3 compares) plus a per-mode scan of
// the block for every candidate mode was ~450 bytecode ops a code
// line; this is ~25 and a miss costs 3.
//
//
// L1b REL fixup list, heap-backed: ONE array of 4-byte records in the
// object file's own dictionary layout (kind, offset lo, offset hi,
// byte3 -- docs/REL-FORMAT.md), so writerelobject() writes it to disk
// in ONE fileio:write straight from here, with no second scratch copy
// of the dictionary (the old parallel arrays + a `2 + 4n + 16*numsyms`
// staging buffer cost a second ~1.5 KB per real liba module on a heap
// that could not spare it -- memory diet, sec above). Sized to
// nfixcand + the lone $00 terminator byte (pass1 counts the
// candidates; a flat assembly allocates 1 record).
//
word fxrec       // heap ptr, 4 bytes/slot: kind, off lo, off hi, b3
                 // (b3 = refnum for an external, the target's low
                 // byte for an internal -- docs/REL-FORMAT.md)
word numfixups
word maxfixups
// CONTIGUOUS commitinst REL state: records,count,limit,refnum,raw,
// kind,selector,enabled. Expression results last until the next eval.
word g_ern, g_eraw
byte g_ek, g_esel, relflag
//
// ProDOS pathnames run to 64 characters; these are Pascal strings
// (length byte + text), so 65. They were 32 until 2026-09-14, when a
// 32-character object path (/usr/lib/LIBPROSHIM/PROSHIMP2R) lost its
// last character to srcpath's length byte -- strcpy copies len+1 --
// and "nas: cannot write" named a path one letter short.
byte[65] putpath
//
// Scratch parse-result globals, set by lineprep().
//
word g_labelptr, g_labellen
word g_mnemptr,  g_mnemlen
word g_operptr,  g_operlen
word g_mnh       // the mnemonic's hash bucket (5*c0+3*c1+c2 of its
                 // folded first three letters, mod 256), by lineprep
word g_nh        // namescan's hash of the last name it scanned
// evalexpr's REL result, valid until the next evaluation. No source
// pointer cache: EQU retries, local zones and curstar can all change.
word g_erel
byte g_eop
// Unknown-label diagnostics (KFIX10 item 1). g_chk is raised for
// pass 2 only: pass 1 MUST let a forward reference through, and by
// pass 2 every label is final, so an unresolved term is simply an
// unknown label. evalterm2 records the first one it meets in
// (g_unp, g_unl); evalexpr reports it after the whole expression.
// g_eqbad: the EQU retry met an unresolved EQU, so pass 2 re-checks
// its EQU lines (where the file and line are known). g_putbase and
// g_putlines turn the stream ordinal g_lineno into a line of the
// file being read.
byte g_chk, g_eqbad, g_unbad
word g_unp, g_unl, g_nunk
word g_putbase, g_putlines
// Unused former pass0 counters, retained as legacy layout slots.
word s0_lc       // +0  lines with a label or a mnemonic
word s0_sc       // +2  labels
word s0_lo       // +4  :locals
word s0_cl       // +6  code lines (opcode mnemonic)
word s0_name     // +8  name-arena bytes (min(len,13)+1 per label)
word s0_stop     // +10 1: stopped AT a line PLASMA must classify
//
// argv scratch.
//
byte[65] objpath
byte[65] srcpath
// All native text from this zero-byte export to bytecode is immutable.
// plascut --immutable-native NAS uses this verified ESD boundary.
predef lineprep(a,b,c,d)#1
predef mnlook(a,b,c,d,e)#0
predef numscan(a,b,c)#1
predef namescan(a,b,c)#1
predef findsymh(a,b,c,d)#1
predef fastprobe(a)#1
predef noteinst(a,b,c,d)#1
predef commitinst(a,b,c,d,e)#1
predef fastloop(a,b)#1
predef fastvalue(a)#1
word loopseed[] = @g_line,@g_labelptr,@dirhash,@rd_buf0,@mnhead,@optab,@g_blo,@opmode
word = @modestrm,@outbuf,@fxrec,@xcflag,@dumflag,@hashhead,@curzone,@curstar
word = @lineprep,@mnlook,@numscan,@namescan,@findsymh,@fastprobe,@noteinst,@commitinst
word = @fastloop,0,0,0,0,0,0,0
word = 0,0,@rd_inputt,@modeprefix,@modetrim,@fastvalue,0,0
word = 0,0,0
export asm ckdataend()#0
end
//
// ---- helpers -------------------------------------------------------
//
// xalloc -- heapalloc with the failure CHECKED. rt's allocheap returns
// 0 when sbrk refuses (the process break would pass $BF00), and every
// caller here used to store that 0 as a buffer pointer and keep going
// -- pass2 then wrote object bytes over zero page (nas.pla's own
// older comments record two such "garbled bytes, exit 0" incidents),
// and the linker-path spike's REL forms (docs/AS-LINKER-SPIKE.md) did
// worse: the PUT expansion's `xbuf = 0` sent appendbytes() through
// the PLASMA VM's OWN zero-page state, which presented as a HANG past
// 750M cycles that a whole handoff document then mis-filed as an
// infinite loop in the REL directives. Arithmetic settled it: the
// cooked nas leaves ~16 KB of heap and that "150-line" module splices
// 12.9 KB of equ files. An exhausted heap is now a one-line error.
//
// findcr -- index of the first $0D in the n bytes at p, or n; a line
// ends on ($0D OR $8D) -- (b & $7F) == $0D -- and every byte scanned
// is MASKED to low ASCII in place (KFIX10 item 2), so maux text
// (high-bit, $8D: what vi writes) and ProDOS standard text (low,
// $0D) assemble alike, and the tokenizer below still compares
// low-bit characters only. The block buffer is consumed once per
// pass, so masking it in place costs no copy. The reader's byte
// loop was 28% of nas's own cycles as PLASMA bytecode
// ($F2 histogram, L3); this is the one native block in nas. The VM
// zero-page names are inlined verbatim from plvmzp.inc (rt.pla's own
// practice: no include path), and the block holds no absolute
// self-reference (the M2 rule for a relocatable module): zero page,
// the eval stack and relative branches only. Args: p at ESTK+1,
// n at ESTK; result replaces p's slot.
asm findcr(p, n)#1
SRC     =   $06
SRCL    =   SRC
SRCH    =   SRC+1
DST     =   SRC+2
DSTL    =   DST
DSTH    =   DST+1
ESGUARD =   $9E
ESTKSZ  =   $40
ESTK    =   $A0
ESTKH   =   ESTK
ESTKL   =   ESTK+ESTKSZ/2
VMZP    =   ESTK+ESTKSZ
IFP     =   VMZP
PP      =   IFP+2
IPY     =   PP+2
ESP     =   IPY+1
JMPTMP  =   ESP+1
TMP     =   JMPTMP+1
TMPL    =   TMP
TMPH    =   TMP+1
        LDA     ESTKL+1,X
        STA     SRCL
        LDA     ESTKH+1,X
        STA     SRCH
        LDY     #$00
FCLOOP  LDA     ESTKL,X
        ORA     ESTKH,X
        BEQ     FCDONE
        LDA     (SRC),Y
        AND     #$7F
        STA     (SRC),Y
        CMP     #$0D
        BEQ     FCDONE
        INY
        BNE     FCNOPG
        INC     SRCH
FCNOPG  LDA     ESTKL,X
        BNE     FCDEC
        DEC     ESTKH,X
FCDEC   DEC     ESTKL,X
        CLC
        BCC     FCLOOP
FCDONE  INX
        LDA     SRCH
        SEC
        SBC     ESTKH,X
        STA     ESTKH,X
        STY     ESTKL,X
        RTS
end
// One native line front: reader hit, tokenization, directive lookup.
// Args: slot (0 = already served), lineinfo, tokens, dirhash/dirtbl.
// Return D_CODE/directive, -1 blank, or -2 transactional reader miss.
// Four consumed argument slots plus SRC/DST/TMP/ESGUARD are scratch.
// The tokenizer uses at most three balanced hardware-stack bytes.
// Internal transfers are relative: these immutable bytes relocate intact.
asm lineprep(slot, lineinfo, tokens, dirs)#1
        LDA     ESTKL+2,X
        STA     DSTL
        LDA     ESTKH+2,X
        STA     DSTH
        LDA     ESTKL+3,X
        STA     SRCL
        LDA     ESTKH+3,X
        STA     SRCH
        ORA     SRCL
        BEQ     LPSERVED
        LDY     #$04               ; count = fill - pos
        LDA     (SRC),Y
        LDY     #$02
        SEC
        SBC     (SRC),Y
        STA     ESTKL+2,X
        LDY     #$05
        LDA     (SRC),Y
        LDY     #$03
        SBC     (SRC),Y
        STA     ESTKH+2,X
        LDY     #$00               ; TMP = buf + pos
        LDA     (SRC),Y
        LDY     #$02
        CLC
        ADC     (SRC),Y
        STA     TMPL
        LDY     #$01
        LDA     (SRC),Y
        LDY     #$03
        ADC     (SRC),Y
        STA     TMPH
        LDA     #$00               ; physical length's page count
        STA     ESTKH+3,X
        LDA     ESTKL+2,X
        STA     ESGUARD            ; final partial page's byte count
        LDY     #$00
        LDA     ESTKH+2,X
        BEQ     RLTAIL
RLPAGE  LDA     (TMP),Y             ; full 256-byte spans need no word count
        AND     #$7F                ; polarity-blind: mask in place (findcr)
        STA     (TMP),Y
        CMP     #$0D
        BEQ     RLHIT
        INY
        BNE     RLPAGE
        INC     TMPH
        INC     ESTKH+3,X
        DEC     ESTKH+2,X
        BNE     RLPAGE
RLTAIL  CPY     ESGUARD
        BEQ     RLNONE
        LDA     (TMP),Y
        AND     #$7F
        STA     (TMP),Y
        CMP     #$0D
        BEQ     RLHIT
        INY
        BNE     RLTAIL             ; tail is at most 255 bytes
RLNONE  LDA     #$FE
        STA     ESTKL+3,X
        LDA     #$FF
        STA     ESTKH+3,X
        INX
        INX
        INX
        RTS
LPSERVED CLC
        BCC     LPPARSE
RLHIT   TYA
        STA     ESTKL+3,X          ; physical length, before clamping
        LDY     #$00               ; commit line pointer only after CR
        LDA     (SRC),Y
        LDY     #$02
        CLC
        ADC     (SRC),Y
        LDY     #$00
        STA     (DST),Y
        INY
        LDA     (SRC),Y
        LDY     #$03
        ADC     (SRC),Y
        LDY     #$01
        STA     (DST),Y
        LDY     #$02               ; pos += len + 1
        LDA     (SRC),Y
        SEC                        ; +1 via the carry
        ADC     ESTKL+3,X
        STA     (SRC),Y
        INY
        LDA     (SRC),Y
        ADC     ESTKH+3,X
        STA     (SRC),Y
        LDA     ESTKH+3,X            ; clamp: len > 255 -> 255
        BEQ     RLLEN
        LDA     #$FF
        STA     ESTKL+3,X
        LDA     #$00
        STA     ESTKH+3,X
RLLEN   LDY     #$02               ; rd_linelen = len
        LDA     ESTKL+3,X
        STA     (DST),Y
        INY
        LDA     ESTKH+3,X
        STA     (DST),Y
        INY                        ; g_lineno++
        LDA     (DST),Y
        CLC
        ADC     #$01
        STA     (DST),Y
        INY
        LDA     (DST),Y
        ADC     #$00
        STA     (DST),Y
LPPARSE LDY     #$02
        LDA     (DST),Y
        STA     TMPL               ; bounded logical length
        LDY     #$00
        LDA     (DST),Y
        STA     SRCL
        INY
        LDA     (DST),Y
        STA     SRCH
        LDA     ESTKL+1,X
        STA     DSTL
        LDA     ESTKH+1,X
        STA     DSTH
        LDA     #$00
        LDY     #$02               ; labellen = mnemlen = operlen = 0
        STA     (DST),Y
        INY
        STA     (DST),Y
        LDY     #$06
        STA     (DST),Y
        INY
        STA     (DST),Y
        LDY     #$0A
        STA     (DST),Y
        INY
        STA     (DST),Y
        LDA     TMPL
        BEQ     TKDONE0
        LDY     #$00
        LDA     (SRC),Y
        CMP     #$2A               ; '*' (sources are LOW-bit ASCII)
        BEQ     TKDONE0
        CMP     #$20               ; ' '
        BEQ     TKSKIP1
;       label: from column 0 to the first space
TKLAB   INY
        CPY     TMPL
        BCS     TKLABE
        LDA     (SRC),Y
        CMP     #$20
        BNE     TKLAB
TKLABE  STY     TMPH               ; labellen = Y
        TYA
        PHA
        LDY     #$00               ; labelptr = SRC
        LDA     SRCL
        STA     (DST),Y
        INY
        LDA     SRCH
        STA     (DST),Y
        INY
        LDA     TMPH
        STA     (DST),Y
        INY
        LDA     #$00
        STA     (DST),Y
        PLA
        TAY
TKSKIP1 CPY     TMPL
        BCS     TKDONE0
        LDA     (SRC),Y
        CMP     #$20
        BNE     TKMN0
        INY
        BNE     TKSKIP1            ; always (Y <= 255)
TKDONE0 LDY     #$02               ; no mnemonic: label-only or blank
        LDA     (DST),Y
        BEQ     LPBLANK
        LDA     #$00
        BEQ     LPEARLY
LPBLANK LDA     #$FF
LPEARLY STA     ESTKL+3,X
        STA     ESTKH+3,X
        INX
        INX
        INX
        RTS
TKMN0   CMP     #$3B               ; ';'
        BEQ     TKDONE0
        STY     TMPH               ; mnemonic start
TKMN    INY
        CPY     TMPL
        BCS     TKMNE
        LDA     (SRC),Y
        CMP     #$20
        BNE     TKMN
TKMNE   TYA
        PHA
        SEC
        SBC     TMPH               ; mnemlen = Y - start
        PHA
        CLC
        LDA     SRCL
        ADC     TMPH
        PHA
        LDA     SRCH
        ADC     #$00
        LDY     #$05
        STA     (DST),Y            ; mnemptr hi
        DEY
        PLA
        STA     (DST),Y            ; mnemptr lo
        LDY     #$06
        PLA
        STA     (DST),Y            ; mnemlen lo
        INY
        LDA     #$00
        STA     (DST),Y
;       g_mnh = 5*c0 + 3*c1 + c2 of the FOLDED first three letters
;       (mod 256; a missing third letter counts 0): the bucket lineprep
;       and fillmodes probe, hashed here once instead of per walk
        LDY     TMPH
        LDA     (SRC),Y
        AND     #$DF
        STA     ESGUARD            ; c0
        ASL
        ASL
        CLC
        ADC     ESGUARD            ; 5*c0
        STA     ESGUARD
        LDY     #$06
        LDA     (DST),Y            ; mnemlen
        CMP     #$02
        BCC     TKHASH
        LDY     TMPH
        INY
        LDA     (SRC),Y
        AND     #$DF
        PHA
        ASL
        CLC
        ADC     ESGUARD            ; +2*c1
        STA     ESGUARD
        PLA
        CLC
        ADC     ESGUARD            ; +c1
        STA     ESGUARD
        LDY     #$06
        LDA     (DST),Y
        CMP     #$03
        BCC     TKHASH
        LDY     TMPH
        INY
        INY
        LDA     (SRC),Y
        AND     #$DF
        CLC
        ADC     ESGUARD            ; +c2
        STA     ESGUARD
TKHASH  LDY     #$0C
        LDA     ESGUARD
        STA     (DST),Y            ; g_mnh
        INY
        LDA     #$00
        STA     (DST),Y
        PLA
        TAY
TKSKIP2 CPY     TMPL
        BCS     TKDONE1
        LDA     (SRC),Y
        CMP     #$20
        BNE     TKOP0
        INY
        BNE     TKSKIP2
TKDONE1 CLC
        BCC     LPCLASS
TKOP0   CMP     #$3B               ; ';'
        BEQ     TKDONE1
        STY     TMPH               ; operand start
TKOP    CPY     TMPL
        BCS     TKOPE
        LDA     (SRC),Y
        CMP     #$22               ; '"'
        BEQ     TKQ
        CMP     #$27               ; '\''
        BEQ     TKQ
        CMP     #$20
        BEQ     TKOPE
        CMP     #$3B
        BEQ     TKOPE
        INY
        BNE     TKOP
        BEQ     TKOPE
TKQ     STA     ESGUARD            ; the delimiter (a VM guard byte,
        INY                        ; unused while an asm call runs)
TKQL    CPY     TMPL
        BCS     TKOPE
        LDA     (SRC),Y
        CMP     ESGUARD
        BEQ     TKQE
        INY
        BNE     TKQL
TKQE    INY
        CPY     TMPL
        BCC     TKOP
        BEQ     TKOP
TKOPE   TYA
        SEC
        SBC     TMPH               ; operlen = Y - start
        PHA
        CLC
        LDA     SRCL
        ADC     TMPH
        PHA
        LDA     SRCH
        ADC     #$00
        LDY     #$09
        STA     (DST),Y            ; operptr hi
        DEY
        PLA
        STA     (DST),Y            ; operptr lo
        LDY     #$0A
        PLA
        STA     (DST),Y            ; operlen lo
        INY
        LDA     #$00
        STA     (DST),Y
LPCLASS
        LDA     ESTKL,X
        STA     DSTL
        LDA     ESTKH,X
        STA     DSTH
        LDA     ESTKL+1,X
        STA     SRCL
        LDA     ESTKH+1,X
        STA     SRCH
        LDY     #$06
        LDA     (SRC),Y
        CMP     #$02
        BCC     NDNONE
        CMP     #$05
        BCS     NDNONE
        STA     ESGUARD
        LDY     #$0C
        LDA     (SRC),Y
        STA     ESTKH,X            ; consumed argument: saved hash
        TAY
        LDA     (DST),Y
        BEQ     NDNONE
        SEC
        SBC     #$01
        STA     TMPL
        ASL
        ASL
        ASL
        SEC
        SBC     TMPL               ; 7*(entry-1), at most 175
        CLC
        ADC     DSTL
        STA     DSTL
        LDA     DSTH
        ADC     #$01               ; skip the 256-byte hash table
        STA     DSTH
        LDY     #$04
        LDA     (SRC),Y
        SEC
        SBC     #$03
        STA     TMPL
        INY
        LDA     (SRC),Y
        SBC     #$00
        STA     SRCH
        LDA     TMPL
        STA     SRCL               ; p-3 aligns with record name
NDLOOP  LDY     #$00
        LDA     (DST),Y
        CMP     ESTKH,X
        BNE     NDNONE
        LDY     #$02
        LDA     (DST),Y
        CMP     ESGUARD
        BNE     NDNEXT
        ADC     #$01               ; CMP equal: carry=1, len+2
        TAY
NDCMP   LDA     (SRC),Y
        AND     #$DF
        CMP     (DST),Y
        BNE     NDNEXT
        DEY
        CPY     #$02
        BNE     NDCMP
        LDY     #$01
        LDA     (DST),Y
        BNE     NDRET              ; every directive ID is nonzero
NDNONE  LDA     #$00
NDRET   INX
        INX
        INX
        STA     ESTKL,X
        LDA     #$00
        STA     ESTKH,X
        RTS
NDNEXT  CLC
        LDA     DSTL
        ADC     #$07
        STA     DSTL
        BCC     NDLOOP
        INC     DSTH
        BCS     NDLOOP
end
// Native symbol-chain walk. Args: p, l (0..255), head, query zone.
// Compare raw names (13 significant bytes); only a RECORD zone of
// $FFFF is a wildcard. No VM calls or extra evaluation-stack slots.
asm findsymh(p, l, head, zone)#1
        LDA     ESTKL+3,X
        SEC
        SBC     #$01
        STA     SRCL
        LDA     ESTKH+3,X
        SBC     #$00
        STA     SRCH               ; p-1, names have a length byte
        LDA     ESTKL+2,X
        CMP     #$0E
        BCC     NSLEN
        LDA     #$0D
NSLEN   STA     ESGUARD
        LDA     ESTKL+1,X
        STA     DSTL
        LDA     ESTKH+1,X
        STA     DSTH
NSLOOP  LDA     DSTL
        ORA     DSTH
        BEQ     NSDONE
        LDY     #$00
        LDA     (DST),Y
        STA     TMPL
        INY
        LDA     (DST),Y
        STA     TMPH
        DEY
        LDA     (TMP),Y
        CMP     ESGUARD
        BNE     NSNEXT
        LDY     ESGUARD
        BEQ     NSZONE
NSCMP   LDA     (SRC),Y
        CMP     (TMP),Y
        BNE     NSNEXT
        DEY
        BNE     NSCMP
NSZONE  LDY     #$04
        LDA     (DST),Y
        CMP     ESTKL,X
        BNE     NSWILD
        INY
        LDA     (DST),Y
        CMP     ESTKH,X
        BEQ     NSDONE
NSWILD  LDY     #$04
        LDA     (DST),Y
        INY
        AND     (DST),Y
        CMP     #$FF
        BEQ     NSDONE
NSNEXT  LDY     #$06
        LDA     (DST),Y
        PHA
        INY
        LDA     (DST),Y
        STA     DSTH
        PLA
        STA     DSTL
        BCC     NSLOOP             ; unconditional relative branch
        BCS     NSLOOP
NSDONE  INX
        INX
        INX
        LDA     DSTL
        STA     ESTKL,X
        LDA     DSTH
        STA     ESTKH,X
        RTS
end
// numscan -- a `$hex` or decimal number at p: writes its 16-bit value
// at res and returns the characters consumed (0 = not a number; a bare
// `$` is 1, value 0 -- the merlin32 reading). ONE pass: the PLASMA
// version scanned the digits to find their extent and then hexval()
// scanned them again. Args p (ESTK+2), l (ESTK+1, <= 255), res (ESTK).
// TMP holds the value, ESGUARD the index, (DST) is scratch for the
// decimal x10.
asm numscan(p, l, rp)#1
        LDA     ESTKL+2,X
        STA     SRCL
        LDA     ESTKH+2,X
        STA     SRCH
        LDA     ESTKL,X
        STA     DSTL
        LDA     ESTKH,X
        STA     DSTH
        LDA     #$00
        STA     TMPL
        STA     TMPH
        STA     ESGUARD
        LDA     ESTKL+1,X
        BEQ     NSNONE
        LDY     #$00
        LDA     (SRC),Y
        CMP     #$24               ; '$'
        BEQ     NSHEX
        CMP     #$30               ; '0'
        BCC     NSNONE
        CMP     #$3A
        BCC     NSDEC
NSNONE  INX                        ; not a number: 0 consumed
        INX
        LDA     #$00
        STA     ESTKL,X
        STA     ESTKH,X
        RTS
NSDEC   LDY     ESGUARD
        TYA
        CMP     ESTKL+1,X
        BCS     NSDX
        LDA     (SRC),Y
        CMP     #$30
        BCC     NSDX
        CMP     #$3A
        BCS     NSDX
        SEC
        SBC     #$30
        PHA
        ASL     TMPL
        ROL     TMPH               ; t = v*2
        LDY     #$00
        LDA     TMPL
        STA     (DST),Y
        INY
        LDA     TMPH
        STA     (DST),Y
        ASL     TMPL
        ROL     TMPH
        ASL     TMPL
        ROL     TMPH               ; t*4
        LDY     #$00
        LDA     TMPL
        CLC
        ADC     (DST),Y
        STA     TMPL
        INY
        LDA     TMPH
        ADC     (DST),Y
        STA     TMPH               ; v*10
        PLA
        CLC
        ADC     TMPL
        STA     TMPL
        BCC     NSDEC1
        INC     TMPH
NSDEC1  INC     ESGUARD
        BNE     NSDEC              ; always (index < 256)
NSDX    CLV
        BVC     NSEND              ; (a hop: NSEND is past the hex loop)
NSHEX   INC     ESGUARD            ; past the '$'
NSHL    LDY     ESGUARD
        TYA
        CMP     ESTKL+1,X
        BCS     NSEND
        LDA     (SRC),Y
        CMP     #$61               ; 'a'
        BCC     NSHF
        AND     #$DF               ; fold
NSHF    CMP     #$30
        BCC     NSEND
        CMP     #$3A
        BCC     NSHD               ; a digit
        CMP     #$41               ; 'A'
        BCC     NSEND
        CMP     #$47               ; 'F'+1
        BCS     NSEND
        SEC
        SBC     #$37               ; 'A' -> 10
        CLV
        BVC     NSHV
NSHD    SEC
        SBC     #$30
NSHV    ASL     TMPL               ; v = (v << 4) | d
        ROL     TMPH
        ASL     TMPL
        ROL     TMPH
        ASL     TMPL
        ROL     TMPH
        ASL     TMPL
        ROL     TMPH
        ORA     TMPL
        STA     TMPL
        INC     ESGUARD
        BNE     NSHL               ; always
NSEND   LDY     #$00
        LDA     TMPL
        STA     (DST),Y
        INY
        LDA     TMPH
        STA     (DST),Y
        INX
        INX
        LDA     ESGUARD
        STA     ESTKL,X
        LDA     #$00
        STA     ESTKH,X
        RTS
end
// namescan -- the run of name characters at p (letters either case,
// digits, `_`, `:`): returns its length (0 = none) and writes the
// symbol hash at res -- hashname()'s value, h = min(len,13) then
// h = h*5 + byte over the first min(len,13) RAW bytes, low 8 bits
// (the table is 128 buckets, so the low byte is all hashname keeps).
// Args p (ESTK+2), l (ESTK+1, <= 255), res (ESTK).
asm namescan(p, l, rp)#1
        LDA     ESTKL+2,X
        STA     SRCL
        LDA     ESTKH+2,X
        STA     SRCH
        LDA     ESTKL,X
        STA     DSTL
        LDA     ESTKH,X
        STA     DSTH
        LDY     #$00
NMSCAN  TYA
        CMP     ESTKL+1,X
        BCS     NMEND
        LDA     (SRC),Y
        CMP     #$61               ; 'a'
        BCC     NMF
        AND     #$DF
NMF     CMP     #$30
        BCC     NMEND
        CMP     #$3A
        BCC     NMOK               ; digit
        BEQ     NMOK               ; ':'
        CMP     #$41
        BCC     NMEND
        CMP     #$5B               ; 'Z'+1
        BCC     NMOK
        CMP     #$5F               ; '_'
        BNE     NMEND
NMOK    INY
        BNE     NMSCAN             ; always
NMEND   STY     ESGUARD            ; the run length
        TYA
        CMP     #$0E
        BCC     NMH0
        LDA     #$0D               ; hash over at most 13
NMH0    STA     TMPL               ; m
        STA     TMPH               ; h = m
        LDY     #$00
NMHASH  CPY     TMPL
        BCS     NMHDONE
        LDA     TMPH
        ASL
        ASL
        CLC
        ADC     TMPH               ; h*5
        CLC
        ADC     (SRC),Y            ; + raw byte
        STA     TMPH
        INY
        BNE     NMHASH             ; always
NMHDONE LDY     #$00
        LDA     TMPH
        STA     (DST),Y
        INY
        LDA     #$00
        STA     (DST),Y
        INX
        INX
        LDA     ESGUARD
        STA     ESTKL,X
        LDA     #$00
        STA     ESTKH,X
        RTS
end
// nameeq -- 1 when the l bytes at p equal the l bytes at q (findsym's
// chain compare, which was a PLASMA loop per character).
// Args p (ESTK+2), q (ESTK+1), l (ESTK, <= 255).
asm nameeq(p, qp, l)#1
        LDA     ESTKL+2,X
        STA     SRCL
        LDA     ESTKH+2,X
        STA     SRCH
        LDA     ESTKL+1,X
        STA     DSTL
        LDA     ESTKH+1,X
        STA     DSTH
        LDY     ESTKL,X
        INX
        INX
        LDA     #$01
        STA     ESTKL,X
        LDA     #$00
        STA     ESTKH,X
NEQL    DEY
        BMI     NEQOK
        LDA     (SRC),Y
        CMP     (DST),Y
        BEQ     NEQL
        LDA     #$00
        STA     ESTKL,X
NEQOK   RTS
end
// itemscan -- the end of the list item that starts at index st in
// the l bytes at p: the index of its terminating comma (quotes
// protect commas) or l. Args p (ESTK+2), l (ESTK+1), st (ESTK).
asm itemscan(p, l, st)#1
        LDA     ESTKL+2,X
        STA     SRCL
        LDA     ESTKH+2,X
        STA     SRCH
        LDY     ESTKL,X
        LDA     #$00
        STA     ESGUARD            ; the open quote, 0 outside quotes
ISLOOP  TYA
        CMP     ESTKL+1,X          ; Y >= l ?
        BCS     ISEND
        LDA     ESGUARD
        BEQ     ISOUT
        LDA     (SRC),Y            ; inside quotes: only the close matters
        CMP     ESGUARD
        BNE     ISNEXT
        LDA     #$00
        STA     ESGUARD
        BEQ     ISNEXT             ; always
ISOUT   LDA     (SRC),Y
        CMP     #$22               ; '"'
        BEQ     ISQ
        CMP     #$27               ; '''
        BEQ     ISQ
        CMP     #$2C               ; ','
        BEQ     ISEND
        BNE     ISNEXT             ; always
ISQ     STA     ESGUARD
ISNEXT  INY
        BNE     ISLOOP             ; always (l <= 255)
ISEND   INX
        INX
        TYA
        STA     ESTKL,X
        LDA     #$00
        STA     ESTKH,X
        RTS
end
// hashname -- the symbol table's hash of the l (<= 13) bytes at p:
// h = l, then h = h*5 + byte per byte, & (HASHSIZE-1). 8-bit
// arithmetic: HASHSIZE is 128, so only the low byte ever mattered.
// Args p (ESTK+1), l (ESTK). Native since 2026-09-14 (it was a PLASMA
// loop run three times per label).
asm hashname(p, l)#1
        LDA     ESTKL+1,X
        STA     SRCL
        LDA     ESTKH+1,X
        STA     SRCH
        LDA     ESTKL,X
        STA     TMPL               ; l
        STA     TMPH               ; h = l
        LDY     #$00
HNLOOP  CPY     TMPL
        BCS     HNDONE
        LDA     TMPH
        ASL
        ASL
        CLC
        ADC     TMPH
        CLC
        ADC     (SRC),Y
        STA     TMPH
        INY
        BNE     HNLOOP             ; always
HNDONE  INX
        LDA     TMPH
        AND     #$7F               ; HASHSIZE - 1
        STA     ESTKL,X
        LDA     #$00
        STA     ESTKH,X
        RTS
end
// mnlook -- the opcode-table probe, native: the mnemonic at mnp
// (three letters, folded) in hash bucket h. tbl = @mnhead, with
// mnnext (+256), mnend (+434) and mnbits (+612, words) laid out
// behind it; opt = @optab (6-byte rows); blk = @g_blo: g_blo +0,
// g_bcnt +2, g_bhi +4, g_bptr +6, g_bend +8, g_bits +10 -- all six
// written on a hit, g_blo=1/g_bhi=0/g_bcnt=0/g_bits=0 on a miss.
// Args h (ESTK+4), mnp (ESTK+3), tbl (ESTK+2), opt (ESTK+1), blk
// (ESTK). TMPL/TMPH/ESGUARD hold c0/c1/c2 during the walk, then
// scratch; the h slot holds the current row r; DST is the row
// pointer, then blk.
asm mnlook(h, mnp, tbl, opt, blk)#0
        LDA     ESTKL+3,X
        STA     SRCL
        LDA     ESTKH+3,X
        STA     SRCH
        LDY     #$00
        LDA     (SRC),Y
        AND     #$DF
        STA     TMPL               ; c0
        INY
        LDA     (SRC),Y
        AND     #$DF
        STA     TMPH               ; c1
        INY
        LDA     (SRC),Y
        AND     #$DF
        STA     ESGUARD            ; c2
        LDA     ESTKL+2,X
        STA     SRCL
        LDA     ESTKH+2,X
        STA     SRCH               ; SRC = tbl (mnhead)
        LDY     ESTKL+4,X
        LDA     (SRC),Y            ; r = mnhead[h]
MLWALK  CMP     #$FF
        BEQ     MLMISS
        STA     ESTKL+4,X          ; r
;       DST = opt + r*6
        LDA     #$00
        STA     DSTH
        LDA     ESTKL+4,X
        ASL
        ROL     DSTH
        ASL
        ROL     DSTH               ; r*4
        STA     DSTL
        LDA     ESTKL+4,X
        ASL                        ; r*2 (carry = bit 8)
        BCC     ML6A
        INC     DSTH
ML6A    CLC
        ADC     DSTL
        STA     DSTL
        BCC     ML6B
        INC     DSTH               ; r*6 (<= 1062)
ML6B
        CLC
        LDA     DSTL
        ADC     ESTKL+1,X
        STA     DSTL
        LDA     DSTH
        ADC     ESTKH+1,X
        STA     DSTH
        LDY     #$00
        LDA     (DST),Y
        CMP     TMPL
        BNE     MLNEXT
        INY
        LDA     (DST),Y
        CMP     TMPH
        BNE     MLNEXT
        INY
        LDA     (DST),Y
        CMP     ESGUARD
        BEQ     MLHIT
MLNEXT  INC     SRCH               ; r = mnnext[r] (tbl + 256 + r)
        LDY     ESTKL+4,X
        LDA     (SRC),Y
        DEC     SRCH
        CLC
        BCC     MLWALK
MLMISS  LDA     ESTKL,X
        STA     DSTL
        LDA     ESTKH,X
        STA     DSTH               ; DST = blk
        LDY     #$00
        LDA     #$01
        STA     (DST),Y            ; g_blo = 1
        LDA     #$00
        INY
        STA     (DST),Y
        INY
        STA     (DST),Y            ; g_bcnt = 0
        INY
        STA     (DST),Y
        INY
        STA     (DST),Y            ; g_bhi = 0
        INY
        STA     (DST),Y
        LDY     #$0A
        STA     (DST),Y            ; g_bits = 0
        INY
        STA     (DST),Y
        INX                        ; pop the five arguments
        INX
        INX
        INX
        INX
        RTS
MLHIT   LDA     DSTL               ; the row pointer -> g_bptr
        PHA
        LDA     DSTH
        PHA
        LDA     ESTKL,X
        STA     DSTL
        LDA     ESTKH,X
        STA     DSTH               ; DST = blk
        LDY     #$07
        PLA
        STA     (DST),Y            ; g_bptr hi
        DEY
        PLA
        STA     (DST),Y            ; g_bptr lo
        LDY     #$00
        LDA     ESTKL+4,X
        STA     (DST),Y            ; g_blo = r
        INY
        LDA     #$00
        STA     (DST),Y
;       hi = mnend[r] = tbl[434 + r]
        LDA     ESTKL+4,X
        CLC
        ADC     #$B2               ; 178
        TAY
        LDA     SRCH
        ADC     #$01
        STA     SRCH
        LDA     (SRC),Y
        STA     TMPL               ; hi
        LDA     ESTKH+2,X
        STA     SRCH               ; SRC = tbl again
        LDY     #$04
        LDA     TMPL
        STA     (DST),Y            ; g_bhi = hi
        INY
        LDA     #$00
        STA     (DST),Y
        LDA     TMPL
        SEC
        SBC     ESTKL+4,X
        CLC
        ADC     #$01
        LDY     #$02
        STA     (DST),Y            ; g_bcnt = hi - r + 1
        INY
        LDA     #$00
        STA     (DST),Y
;       g_bend = opt + hi*6
        STA     TMPH
        LDA     TMPL
        ASL
        ROL     TMPH
        ASL
        ROL     TMPH               ; hi*4 in A:TMPH
        STA     ESGUARD
        LDA     TMPL
        ASL
        BCC     ML6C
        INC     TMPH
ML6C    CLC
        ADC     ESGUARD
        STA     ESGUARD            ; lo of hi*6
        BCC     ML6D
        INC     TMPH               ; hi byte of hi*6
ML6D
        CLC
        LDA     ESGUARD
        ADC     ESTKL+1,X
        LDY     #$08
        STA     (DST),Y
        LDA     TMPH
        ADC     ESTKH+1,X
        INY
        STA     (DST),Y            ; g_bend
;       g_bits = mnbits[r] = word at tbl + 612 + 2r
        LDA     ESTKL+4,X
        ASL
        STA     ESGUARD            ; 2r lo
        LDA     #$00
        ROL                        ; 2r hi (0/1)
        STA     TMPH
        LDA     ESGUARD
        CLC
        ADC     #$64               ; +100 (612 = 2*256 + 100)
        TAY
        LDA     TMPH
        ADC     #$02
        CLC
        ADC     SRCH
        STA     SRCH
        LDA     (SRC),Y
        PHA
        INY
        BNE     MLB2
        INC     SRCH
MLB2    LDA     (SRC),Y
        LDY     #$0B
        STA     (DST),Y            ; g_bits hi
        DEY
        PLA
        STA     (DST),Y            ; g_bits lo
        INX                        ; pop the five arguments
        INX
        INX
        INX
        INX
        RTS
end
// commitinst -- emit directly to outbuf, append REL fixup, advance counters.
// outstate words: buf,fill,total,pc,nfixcand,orgbase.
// relstate: records:2,count:2,limit:2,refnum:2,raw:2,kind:1,sel:1,rel:1.
// Return size, or -1 invalid mode/branch, -2 flush needed, -3 fixups full.
// ALL refusals precede caller-data writes; retry -2 after PLASMA outflush.
// Five arguments, no extra eval slots, stack scratch or text writes.
asm commitinst(op, mode, value, outstate, relstate)#1
        LDA     ESTKL,X
        STA     DSTL
        LDA     ESTKH,X
        STA     DSTH
        LDA     ESTKL+1,X
        STA     SRCL
        LDA     ESTKH+1,X
        STA     SRCH
        LDA     ESTKL+2,X
        STA     TMPL
        LDA     ESTKH+2,X
        STA     TMPH
        LDA     ESTKH+3,X
        BNE     CIBAD
        LDA     ESTKL+3,X
        CMP     #$0F
        BCS     CIBAD
        CMP     #$0E
        BEQ     CIBRANCH
        CMP     #$02
        BCC     CISIZE1
        CMP     #$06
        BCC     CISIZE2
        CMP     #$0A
        BCC     CISIZE3
        CMP     #$0D
        BCC     CISIZE2
CISIZE3 LDA     #$03
        BNE     CISPACE
CISIZE2 LDA     #$02
        BNE     CISPACE
CISIZE1 LDA     #$01
        BNE     CISPACE
CIBRANCH
        LDY     #$06
        LDA     TMPL
        SEC
        SBC     (SRC),Y
        STA     TMPL
        INY
        LDA     TMPH
        SBC     (SRC),Y
        STA     TMPH
        LDA     TMPL
        SEC
        SBC     #$02
        STA     TMPL
        LDA     TMPH
        SBC     #$00
        STA     TMPH
        LDA     TMPL
        CLC
        ADC     #$80
        LDA     TMPH
        ADC     #$00
        BNE     CIBAD
        LDA     #$02
        BNE     CISPACE
CIBAD   INX
        INX
        INX
        INX
        LDA     #$FF
        STA     ESTKL,X
        STA     ESTKH,X
        RTS
CISPACE STA     ESTKL+2,X
        LDY     #$02
        CLC
        ADC     (SRC),Y
        STA     ESTKH+4,X
        INY
        LDA     (SRC),Y
        ADC     #$00
        STA     ESTKH+3,X
        BCS     CIFULL
        CMP     #$02
        BCC     CIRELOC
        BNE     CIFULL
        LDA     ESTKH+4,X
        BEQ     CIRELOC
CIFULL  INX
        INX
        INX
        INX
        LDA     #$FE
        STA     ESTKL,X
        LDA     #$FF
        STA     ESTKH,X
        RTS
CIRELOC LDA     #$00
        STA     ESTKH+2,X
        LDA     ESTKL+2,X
        CMP     #$01
        BEQ     CINOFIX
        LDA     ESTKL+3,X
        CMP     #$0E
        BEQ     CINOFIX
        LDY     #$0C
        LDA     (DST),Y
        BEQ     CINOFIX
        LDY     #$0A
        LDA     (DST),Y
        BEQ     CINOFIX
        STA     ESGUARD
        // Unsigned count < limit; no mutation on exhaustion.
        LDY     #$05
        LDA     (DST),Y
        DEY
        DEY
        CMP     (DST),Y
        BCC     CIFXFULL
        BNE     CIFXOK
        INY
        LDA     (DST),Y
        DEY
        DEY
        CMP     (DST),Y
        BCC     CIFXFULL
        BEQ     CIFXFULL
        BCS     CIFXOK
CINOFIX BEQ     CISKIPFX
CIFXFULL
        INX
        INX
        INX
        INX
        LDA     #$FD
        STA     ESTKL,X
        LDA     #$FF
        STA     ESTKH,X
        RTS
CIFXOK  LDY     #$08
        LDA     (DST),Y
        STA     TMPL
        STA     ESTKL+3,X
        INY
        LDA     (DST),Y
        STA     TMPH
        LDA     ESGUARD
        CMP     #$01
        BEQ     CIKIND
        LDY     #$06
        LDA     (DST),Y
        STA     ESTKL+3,X
CIKIND  LDA     ESTKL+2,X
        CMP     #$03
        BEQ     CIWORD
        LDY     #$0B
        LDA     (DST),Y
        CMP     #$3E
        BEQ     CIHIGH
        LDA     #$0F
        LDY     ESGUARD
        CPY     #$01
        BEQ     CISETK
        LDA     #$1F
        BNE     CISETK
CIHIGH  LDA     TMPH
        CLC
        ADC     #$80
        STA     TMPL
        LDA     #$4F
        LDY     ESGUARD
        CPY     #$01
        BEQ     CISETK
        LDA     #$50
        BNE     CISETK
CIWORD  LDA     TMPH
        CLC
        ADC     #$80
        STA     TMPH
        LDA     #$8F
        LDY     ESGUARD
        CPY     #$01
        BEQ     CISETK
        LDA     #$9F
CISETK  STA     ESTKH+2,X
        CLC
        BCC     CIFIX
// Relative trampoline past fixup setup, still position independent.
CISKIPFX
        CLC
        BCC     CISKIP2
CIFIX   LDY     #$02
        LDA     (DST),Y
        STA     ESTKL,X
        CLC
        ADC     #$01
        STA     (DST),Y
        INY
        LDA     (DST),Y
        STA     ESTKH,X
        ADC     #$00
        STA     (DST),Y
        ASL     ESTKL,X
        ROL     ESTKH,X
        ASL     ESTKL,X
        ROL     ESTKH,X
        LDY     #$00
        LDA     (DST),Y
        CLC
        ADC     ESTKL,X
        STA     ESTKL,X
        INY
        LDA     (DST),Y
        ADC     ESTKH,X
        STA     DSTH
        LDA     ESTKL,X
        STA     DSTL
        // Instruction operand starts one byte after the current PC.
        LDY     #$0A
        LDA     (SRC),Y
        STA     ESTKL+1,X
        INY
        LDA     (SRC),Y
        STA     ESTKH+1,X
        LDY     #$06
        LDA     (SRC),Y
        SEC
        SBC     ESTKL+1,X
        STA     ESTKL+1,X
        INY
        LDA     (SRC),Y
        SBC     ESTKH+1,X
        STA     ESTKH+1,X
        INC     ESTKL+1,X
        BNE     CIOFF
        INC     ESTKH+1,X
CIOFF   LDY     #$00
        LDA     ESTKH+2,X
        STA     (DST),Y
        INY
        LDA     ESTKL+1,X
        STA     (DST),Y
        INY
        LDA     ESTKH+1,X
        STA     (DST),Y
        INY
        LDA     ESTKL+3,X
        STA     (DST),Y
CISKIP2
        // Destination = outbuf + old outfill; new fill was checked above.
        LDY     #$00
        LDA     (SRC),Y
        STA     DSTL
        INY
        LDA     (SRC),Y
        STA     DSTH
        INY
        LDA     (SRC),Y
        CLC
        ADC     DSTL
        STA     DSTL
        INY
        LDA     (SRC),Y
        ADC     DSTH
        STA     DSTH
        LDY     #$00
        LDA     ESTKL+4,X
        STA     (DST),Y
        LDA     ESTKL+2,X
        CMP     #$01
        BEQ     CICOUNTS
        INY
        LDA     TMPL
        STA     (DST),Y
        LDA     ESTKL+2,X
        CMP     #$02
        BEQ     CICOUNTS
        INY
        LDA     TMPH
        STA     (DST),Y
CICOUNTS
        LDY     #$02
        LDA     ESTKH+4,X
        STA     (SRC),Y
        INY
        LDA     ESTKH+3,X
        STA     (SRC),Y
        INY
        LDA     ESTKL+2,X
        CLC
        ADC     (SRC),Y
        STA     (SRC),Y
        INY
        LDA     (SRC),Y
        ADC     #$00
        STA     (SRC),Y
        INY
        LDA     ESTKL+2,X
        CLC
        ADC     (SRC),Y
        STA     (SRC),Y
        INY
        LDA     (SRC),Y
        ADC     #$00
        STA     (SRC),Y
        LDA     ESTKL+2,X
        INX
        INX
        INX
        INX
        STA     ESTKL,X
        LDA     #$00
        STA     ESTKH,X
        RTS
end
// noteinst -- commit a selected opcode to pass 1's replay stream.
// tables: opmode[256], modesize[15]; stream: ptr,count,pos,capacity;
// state: curpc,nfixcand (all words). Return 0 without caller-data
// writes for a non-byte opcode, invalid mode or full stream; else 1.
// The selection caller owns opcode eligibility. No text writes,
// extra eval slots or hardware-stack scratch; all data via arguments.
asm noteinst(op, tables, stream, state)#1
        LDA     ESTKH+3,X
        BEQ     NIVOP
        LDA     #$00
NIRET   INX
        INX
        INX
        STA     ESTKL,X
        LDA     #$00
        STA     ESTKH,X
        RTS
NIVOP   LDA     ESTKL+2,X
        STA     SRCL
        LDA     ESTKH+2,X
        STA     SRCH
        LDY     ESTKL+3,X
        LDA     (SRC),Y
        CMP     #$0F
        BCC     NIMODE
        LDA     #$00
        BEQ     NIRET
NIMODE  STA     ESGUARD
        TAY
        INC     SRCH
        LDA     (SRC),Y
        STA     ESTKL+2,X         ; size, in consumed table argument
        LDA     ESTKL+1,X
        STA     SRCL
        LDA     ESTKH+1,X
        STA     SRCH
        LDY     #$02
        LDA     (SRC),Y
        STA     TMPL
        INY
        LDA     (SRC),Y
        STA     TMPH
        LDY     #$07
        CMP     (SRC),Y
        BCC     NISPACE
        BNE     NIFAIL
        DEY
        LDA     TMPL
        CMP     (SRC),Y
        BCC     NISPACE
NIFAIL  LDA     #$00
        BEQ     NIRET
NISPACE LDY     #$00
        CLC
        LDA     (SRC),Y
        ADC     TMPL
        STA     DSTL
        INY
        LDA     (SRC),Y
        ADC     TMPH
        STA     DSTH
        INY
        CLC
        LDA     TMPL
        ADC     #$01
        STA     (SRC),Y
        INY
        LDA     TMPH
        ADC     #$00
        STA     (SRC),Y
        LDY     #$00
        LDA     ESTKL+3,X
        STA     (DST),Y
        LDA     ESTKL,X
        STA     DSTL
        LDA     ESTKH,X
        STA     DSTH
        CLC
        LDA     (DST),Y
        ADC     ESTKL+2,X
        STA     (DST),Y
        INY
        LDA     (DST),Y
        ADC     #$00
        STA     (DST),Y
        LDA     ESTKL+2,X
        CMP     #$02
        BCC     NIDONE
        LDA     ESGUARD
        CMP     #$0E
        BEQ     NIDONE
        INY
        CLC
        LDA     (DST),Y
        ADC     #$01
        STA     (DST),Y
        INY
        LDA     (DST),Y
        ADC     #$00
        STA     (DST),Y
NIDONE  INX
        INX
        INX
        LDA     #$01
        STA     ESTKL,X
        LDA     #$00
        STA     ESTKH,X
        RTS
end
// Private native ABI: $10-$65 context, $70-$8D ten JMP call gates.
// loopseed above holds compiler-relocated pointers and initial state.
// Reinitialize on EVERY invocation, including cooked warm starts.
// No mutable native text. Services return to PLASMA with explicit
// continuations; reader/labels/replay/PC must not be committed twice.
asm initloop(seed)#0
        LDA ESTKL,X
        STA SRCL
        LDA ESTKH,X
        STA SRCH
        LDY #85
NSCOPY  LDA (SRC),Y
        STA $10,Y
        DEY
        BPL NSCOPY
        LDA #$4C
        STA $70
        LDA $30
        STA $71
        LDA $31
        STA $72
        LDA #$4C
        STA $73
        LDA $32
        STA $74
        LDA $33
        STA $75
        LDA #$4C
        STA $76
        LDA $34
        STA $77
        LDA $35
        STA $78
        LDA #$4C
        STA $79
        LDA $36
        STA $7A
        LDA $37
        STA $7B
        LDA #$4C
        STA $7C
        LDA $38
        STA $7D
        LDA $39
        STA $7E
        LDA #$4C
        STA $7F
        LDA $3A
        STA $80
        LDA $3B
        STA $81
        LDA #$4C
        STA $82
        LDA $3C
        STA $83
        LDA $3D
        STA $84
        LDA #$4C
        STA $85
        LDA $3E
        STA $86
        LDA $3F
        STA $87
        LDA #$4C
        STA $88
        LDA $40
        STA $89
        LDA $41
        STA $8A
        LDA #$4C
        STA $8B
        LDA $5A
        STA $8C
        LDA $5B
        STA $8D
        INX
        RTS
end
asm fastvalue(ctx)#1
!macro NLCTX .slot {
        ORA #0                  ; match the old PLA's N/Z result
}
!macro NLARG .off {
        LDA $10+.off
        DEX
        STA ESTKL,X
        LDA $11+.off
        STA ESTKH,X
}
!macro NLIND .off, .field {
        LDY #.field
        LDA ($10+.off),Y
        DEX
        STA ESTKL,X
        INY
        LDA ($10+.off),Y
        STA ESTKH,X
}
!macro NLADR .off {
        DEX
        LDA #$10+.off
        STA ESTKL,X
        LDA #0
        STA ESTKH,X
}
!macro NLCALL .off {
        !if .off = 74 {
            JSR $8B
        } else {
            JSR $70+(.off-32)/2*3
        }
}
!macro NLSET .off {
        STA $10+.off
        LDA #0
        STA $11+.off
        LDY #.off+1
}
!macro NLPTR .off {
        LDA $10+.off
        STA SRCL
        LDA $11+.off
        STA SRCH
        LDY #.off+1
}
!macro NLCON .val {
        DEX
        LDA #.val
        STA ESTKL,X
        LDA #0
        STA ESTKH,X
}
!macro NLFALL {
        INX
        LDA #0
        STA ESTKL,X
        STA ESTKH,X
        RTS
}
!macro NLNEXT {
        JMP $88
}
!macro NVFAIL {
        LDA #0
        STA ESTKL,X
        STA ESTKH,X
        RTS
}
!macro NLGOTO .target {
        LDA $40
        CLC
        ADC #<(.target-NLENTRY)
        STA TMPL
        LDA $41
        ADC #>(.target-NLENTRY)
        STA TMPH
        JMP JMPTMP
}
!macro NVGOTO .target {
        LDA $5A
        CLC
        ADC #<(.target-NVENTRY)
        STA TMPL
        LDA $5B
        ADC #>(.target-NVENTRY)
        STA TMPH
        JMP JMPTMP
}
NVENTRY +NLCTX 0
        LDA #0
        +NLSET 78
        +NLSET 80
        +NLSET 82
        +NLPTR 54
        LDY #56
        LDA $10,Y
        BEQ NVNUM
        LDY #0
        LDA (SRC),Y
        CMP #'<'
        BEQ NVSEL
        CMP #'>'
        BNE NVNUM
NVSEL   +NLSET 82
        LDY #54
        LDA $10,Y
        CLC
        ADC #1
        STA $10,Y
        INY
        LDA $10,Y
        ADC #0
        STA $10,Y
        LDY #56
        LDA $10,Y
        SEC
        SBC #1
        STA $10,Y
NVNUM
        +NLARG 54
        +NLARG 56
        +NLADR 52
        +NLCALL 36
        LDA ESTKL,X
        INX
        +NLCTX 0
        CMP #0
        BEQ NVNAME
        LDY #56
        CMP $10,Y
        BEQ NVYES
NVNO    LDA #0
NVRET   STA ESTKL,X
        LDA #0
        STA ESTKH,X
        RTS
NVYES   +NVGOTO NVFINAL
