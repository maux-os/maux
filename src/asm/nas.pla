            n = n + emititem(p+start, nx - start, dest + n, kind)
        elsif kind == LK_ASC and isquoteitem(p+start, nx - start)
            n = n + nx - start - 2
        else
            n = n + sz
        fin
        start = nx + 1
    loop
    return n
end
