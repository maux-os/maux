// 2026-09-14): the first sighting records its zone and, after setsym
// has added the slot, that slot; a later sighting in ANOTHER zone
// flips the name ambiguous and PINS the first slot to its own zone
// (it was stored as the wildcard), so the definition about to be
// added lands in a zone-specific slot of its own instead of
// overwriting it. A reference resolved before the flip could only
// have differed in VALUE, never in size (both are code addresses),
// and pass 2 resolves everything against the finished table.
def deflocal(p, l, zone, val)#0
    word idx, slot
    idx = findloc(p, l)
    if not idx
        // Publish only after the symbol exists: reszone during this
        // first setsym must still see an absent, unambiguous name.
        setsym(p, l, val)
        slot = findsym(p, l)
        if slot
            addloc(slot, zone)
        fin
        return
    fin
    slot = *idx
    if *(idx + 2) <> zone and *(slot + 4) == -1
        *(slot + 4) = *(idx + 2)
    fin
    setsym(p, l, val)
end
// deflabel -- pass 1's one way to define the line's label
def deflabel(val)#0
    if ^g_labelptr == ':'
        deflocal(g_labelptr, g_labellen, curzone, val)
    else
        setsym(g_labelptr, g_labellen, val)
    fin
end
//
// ---- expression evaluator --------------------------------------------
// Left-to-right, NO operator precedence, NO parentheses (HACKING.md
// dialect rule: `01M051DJW89KV4JYM1EC9SDZ5Y`). Terms: $hex, decimal,
// "x"/'x' char constants (high/low bit; value = the FIRST char's code,
// the term spans to the matching close quote -- measured: `dfb "AB"`
// uses only 'A'), a label/EQU name, or `*` (this line's own address).
// Operators: + - * /. An optional leading `<`/`>` selects the low/high
// byte of the WHOLE final value (measured: `#<ARGV+2` is low(ARGV+2),
// not low(ARGV)+2).
//
// udiv16 -- UNSIGNED 16-bit division (restoring shift-subtract, 16
// rounds), needed because PLASMA words are SIGNED and nas's evaluator
// routinely divides two location-counter-derived values that can each
// exceed $8000 (an arena above $8000 -- see l2b.s's `err */$9010`
// ceiling idiom, matched against pwd.s/mld.s's own real `err
// */BUILDBASE` tripwires). Native PLASMA `/` treats such an operand
// as NEGATIVE (two's-complement), so `$9006 / $9010` -- both >
// $8000, real quotient 0 -- came back as a WRONG nonzero result
// (MEASURED: signed `/` gave 1, not 0, failing a merlin32-satisfied
// `err`). merlin32 does not have this problem (its evaluator carries
// wider/non-negative arithmetic for a plain address division); nas
// matches that by never asking PLASMA's signed `/` to divide two
// values that might carry a set high bit. isuge (cmdsys.plh) is the
// same unsigned-compare primitive already mandated for address/heap
// compares elsewhere in this file -- this is the same fix, applied to
// division instead of comparison.
def udiv16(a, b)#1
    word q, r
    byte i
    if b == 0
        return 0
    fin
    q = 0
    r = 0
    i = 0
    while i < 16
        r = (r << 1) | ((a >> 15) & 1)
        a = a << 1
        q = q << 1
        if isuge(r, b)
            r = r - b
            q = q | 1
        fin
        i++
    loop
    return q
end
// Count only additive internal terms, exactly as classifyoperand did.
// Non-additive operators govern the NEXT term, not the running count.
def exprrelterm()#0
    if g_eop == '+'
        g_erel++
    elsif g_eop == '-'
        g_erel--
    fin
end
def evalterm2(p, l)#3
    word v, i, idx
    byte c
    if l == 0
        return 0, 1, 0
    fin
    i = numscan(p, l, @v)
    if i
        return v, 1, i
    fin
    c = ^p
    if c == '"' or c == $27
        i = 1
        while i < l and ^(p+i) <> c
            i++
        loop
        v = 0
        if l > 1
            v = ^(p+1) | ((c == '"') ?? $80 :: 0)
        fin
        if i < l
            i++
        fin
        return v, 1, i
    elsif c == '*'
        if relflag
            exprrelterm()
        fin
        return curstar, 1, 1
    else
        i = namescan(p, l, @g_nh)
        if i == 0
            // not a name at all (`%1010`, `-1`): a bad operand, not
            // an unknown label; name what is there, up to 16 bytes
            if not g_unl
                g_unp = p
                g_unl = l
                if l > 16
                    g_unl = 16
                fin
                g_unbad = 1
            fin
            return 0, 0, 1
        fin
        idx = findsymh(p, i, hashhead=>[g_nh & (HASHSIZE - 1)], curzone)
        if idx == 0
            if not g_unl
                g_unp = p
                g_unl = i
            fin
            return 0, 0, i
        else
            c = ^(idx + 8)
            if c & F_PROV
                g_prov = 1          // the EQU reading this must retry
            fin
            if c & F_EXT
                if relflag
                    g_ek = 2
                    g_ern = *(idx + 2)
                fin
                return 0, 1, i      // an EXT symbol's value is 0 (addend form)
            fin
            if relflag and not (c & F_EQU)
                exprrelterm()
            fin
            if not (c & F_DEF)
                if not g_unl
                    g_unp = p
                    g_unl = i
                fin
            fin
            return *(idx + 2), c & F_DEF, i
        fin
    fin
end
// unkreport -- name the unknown label evalterm2 recorded, with the
// file and the line IN that file (a PUT file counts its own lines).
def unkreport()#0
    word i
    if g_unbad
        eputs("nas: bad operand ")
    else
        eputs("nas: unknown label ")
    fin
    i = 0
    while i < g_unl and i < 32
        eputc(^(g_unp + i))
        i++
    loop
    eputs(" (")
    if rd_inputt == 6
        eputs(@putpath)
        eputs(" line ")
        eputi(g_lineno - g_putbase)
    else
        eputs(@srcpath)
        eputs(" line ")
        eputi(g_lineno - g_putlines)
    fin
    eputs(")")
    eputln
    g_nunk++
end
def evalexpr(p, l)#2
    word v, tv, tlen, tres, allres, start
    byte sel, op
    if relflag
        g_ek = 0
        g_ern = 0
        g_erel = 0
        g_eop = '+'
    fin
    sel = 0
    start = 0
    g_unl = 0
    g_unbad = 0
    if l > 0 and (^p == '<' or ^p == '>')
        sel = ^p
        start = 1
    fin
    tv, tres, tlen = evalterm2(p+start, l-start)
    v = tv
    allres = tres
    start = start + tlen
    while start < l
        op = ^(p+start)
        g_eop = op
        start++
        tv, tres, tlen = evalterm2(p+start, l-start)
        if op == '+'
            v = v + tv
        elsif op == '-'
            v = v - tv
        elsif op == '*'
            v = v * tv
        elsif op == '/'
            v = udiv16(v, tv)   // unsigned -- see udiv16's own comment
        elsif op == '.'
            v = v | tv       // Merlin OR (MEASURED vs merlin32 v1.1.10)
        elsif op == '!'
            v = v ^ tv       // Merlin EOR/XOR (MEASURED)
        elsif op == '&'
            v = v & tv       // Merlin AND (MEASURED)
        fin
        allres = allres and tres
        start = start + tlen
    loop
    if g_chk and not allres
        unkreport()
    fin
    if relflag
        g_eraw = v
        g_esel = sel
        if g_ek == 0 and g_erel == 1
            g_ek = 1
        fin
    fin
    if sel == '<'
        v = v & $FF
    elsif sel == '>'
        v = (v >> 8) & $FF
