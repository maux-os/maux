    return v, allres
end
def evalexprval(p, l)#1
    word v, r
    v, r = evalexpr(p, l)
    return v
end
def matchdir(p, l, lit, litlen)#1
    byte i, c
    if l <> litlen
        return 0
    fin
    i = 0
    while i < litlen
        c = ^(p + i)
        if c >= 'a' and c <= 'z'
            c = c - 32                 // inline: toup() was a call per char
        fin
        if c <> ^(lit + i)
            return 0
        fin
        i++
    loop
    return 1
end
//
// ---- L1b REL: relocation classification --------------------------
// evalexpr also classifies a stripped operand as a plain constant, a
// RELOCATABLE reference to a label/`*` defined in THIS module, or a
// reference to an EXT symbol.
//
// L1b's v1 accepted only a BARE name (or `*`) behind an optional
// `<`/`>` selector and reported anything else -- `SYM+1`, `*-2` --
// as a plain constant. The linker-path spike (docs/AS-LINKER-
// SPIKE.md, 2026-09-13) met real liba code on the first module:
// `sta PROCPARM+0` against an EXT arena cell, `#>PFXBUF+1`,
// `PTR+1` on relocatable labels -- 50-odd sites in pwd's closure --
// and a "constant" answer there is a SILENT MIS-LINK (the reference
// resolves to the bare addend, no fixup). So the expression is now
// walked TERM BY TERM, the same left-to-right no-precedence grammar
// evalexpr uses: a relocatable label or `*` counts +1 when added
// (first term, or behind `+`) and -1 behind `-`; an EXT symbol marks
// the whole expression external. The net relocatable count decides:
// exactly 1 -> internal-relocatable (`LABEL+3`, `*-2`), 0 -> constant
// (`END-START` is a length), any EXT -> external. A relocatable term
// behind `*`, `/`, `.`, `!`, `&` has no linkable meaning and is
// treated as constant. The VALUE is evalexpr's own: for an internal
// reference that is the module-relative target INCLUDING the addend
// (what the fixup stores as $8000+value); for an external it is the
// ADDEND alone, since an EXT symbol's own value is 0 -- which is
// exactly the `$8000 + addend` stored form docs/REL-FORMAT.md
// measured (`lda SYM` / `ora SYM+1` -> $8000 / $8001, same refnum).
//
// The result travels alongside the value in g_ek (0 const, 1
// internal, 2 external), g_ern (external refnum), g_esel (leading
// selector), and g_eraw (value BEFORE selecting its high/low byte).
// Consume these before the next evaluation; no re-scan or lookup.
// decidemode forces ABS for g_ek<>0 even if the value fits in ZP.
//
// addfixup -- append one 4-byte REL fixup record (kind, offset into
// the object, refnum-or-target-low-byte). See docs/REL-FORMAT.md.
//
def addfixup(kind, off, b3)#0
    word rp
    if numfixups >= maxfixups
        if not errflag
            eputs("nas: fixup table full line "); eputi(g_lineno); eputln
        fin
        errflag = 1
        return
    fin
    rp = fxrec + numfixups * 4
    ^rp       = kind
    ^(rp + 1) = off & $FF
    ^(rp + 2) = (off >> 8) & $FF
    ^(rp + 3) = b3
    numfixups++
end
//
// relpatch -- the one REL emission rule for a 2-byte or 1-byte field,
// shared by pass2's instruction path and the DA/DW data path. Given
// evalexpr's classification for the field's expression, rewrite the
// field at dest into its stored (fixup) form and record the
// fixup (docs/REL-FORMAT.md's seven kinds):
//   2-byte internal: $8000+target stored, $8F, byte3 = low(target)
//   2-byte external: $8000+addend stored, $9F, byte3 = refnum
//   1-byte internal: `<` low(target) $0F / `>` $80+high(target) $4F,
//                    byte3 = low(target) in both (the carry source)
//   1-byte external: `<` low(addend) $1F / `>` $80+high(addend) $50,
//                    byte3 = refnum
// A kind-0 (constant) answer leaves the field as the plain evaluation
// pass2 already wrote there.
//
def relpatch(dest, width, rk, rn, sel, rv)#0
    word stored, off
    if rk == 0
        return
    fin
    // curpc still names this line, including for each item in a data list.
    // Compute position only for a real fixup, not for every source line.
    off = (curpc - orgbase) + (dest - linebytes)
    if width == 2
        stored = $8000 + rv
        ^dest       = stored & $FF
        ^(dest + 1) = (stored >> 8) & $FF
        if rk == 1
            addfixup($8F, off, stored & $FF)
        else
            addfixup($9F, off, rn)
        fin
        return
    fin
    if sel == '>'
        ^dest = ($80 + ((rv >> 8) & $FF)) & $FF
        if rk == 1
            addfixup($4F, off, rv & $FF)
        else
            addfixup($50, off, rn)
        fin
    else
        ^dest = rv & $FF
        if rk == 1
            addfixup($0F, off, rv & $FF)
        else
            addfixup($1F, off, rn)
        fin
    fin
end
//
