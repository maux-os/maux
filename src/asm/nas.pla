//
// nas.pla -- production streaming two-pass assembler, 2026-09-19.
// Native 6502 control handles instructions, parsing and scalar values;
// PLASMA handles directives, labels, general expressions and services.
// Flat/REL output, PUT/USE splicing, ENT/EXT and 6502/65C02 instructions.
// Symbols, locals, ERR/retry records and opcode replay grow on demand:
// no preliminary source-counting pass or heap-resident source image.
// See docs/NAS-TWO-PASS-REFACTOR.md for the private zero-page ABI,
// allocation layout, independent byte gates and measured trade-offs.
//
// Every opcode/mode/byte and every directive's exact byte behavior
// below was checked against merlin32 v1.1.10 directly (not typed from
// memory) -- see the architect's task notes for the probe sources.
//
include "inc/cmdsys.plh"
include "inc/fileio.plh"
include "inc/args.plh"
//
// ---- addressing modes -----------------------------------------------
//
const M_IMPL  = 0
const M_ACC   = 1
const M_IMM   = 2
const M_ZP    = 3
const M_ZPX   = 4
const M_ZPY   = 5
const M_ABS   = 6
const M_ABSX  = 7
const M_ABSY  = 8
const M_IND   = 9    // (abs) -- JMP only
const M_INDX  = 10   // (zp,X)
const M_INDY  = 11   // (zp),Y
const M_IZP   = 12   // (zp) -- 65C02 addition (LDA/STA/ADC/... family)
const M_AINDX = 13   // (abs,X) -- 65C02 JMP addition
const M_REL   = 14
// directive ids (lineprep; declared here because dirtbl below is data
// that names them)
const D_CODE = 0
const D_EQU  = 1
const D_ORG  = 2
const D_LST  = 3
const D_TR   = 4
