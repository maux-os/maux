// terminator is returned like any other (today's trailing-CR pad rule).
// Native scan (findcr) + native copy (memcpy) per span.
def rdgetline(slot)#1
    word len, buf, pos, fill, n, k, c
    byte got
    len = 0
    got = 0
    while 1
        if slot == 0
            if rd_pos0 >= rd_fill0
                rdrefill(0)
                if rd_fill0 == 0
                    break
                fin
            fin
            buf = rd_buf0
            pos = rd_pos0
            fill = rd_fill0
        else
            if rd_pos1 >= rd_fill1
                rdrefill(1)
                if rd_fill1 == 0
                    break
                fin
            fin
            buf = rd_buf1
            pos = rd_pos1
            fill = rd_fill1
        fin
        got = 1
        n = fill - pos
        k = findcr(buf + pos, n)
        if k < n and len == 0
            // the whole line sits in the block buffer: no copy, the
            // caller reads it there (it is consumed before the next
            // srcline can refill the buffer)
            g_line = buf + pos
            pos = pos + k + 1
            if slot == 0
                rd_pos0 = pos
            else
                rd_pos1 = pos
            fin
            if k > LINEMAX - 1
                k = LINEMAX - 1
            fin
            return k
        fin
        c = k
        if len + c > LINEMAX - 1
            c = LINEMAX - 1 - len
        fin
        if c > 0
            memcpy(linebuf + len, buf + pos, c)
            len = len + c
        fin
        g_line = linebuf
        if k < n
            pos = pos + k + 1              // past the $0D
            if slot == 0
                rd_pos0 = pos
            else
                rd_pos1 = pos
            fin
            return len
        fin
        pos = pos + k                      // buffer exhausted: refill
        if slot == 0
            rd_pos0 = pos
        else
            rd_pos1 = pos
        fin
    loop
    g_line = linebuf
    if got
        return len
    fin
    return -1
end
def srcclose()#0
    if rd_ref1
        fileio:close(rd_ref1)
        rd_ref1 = 0
    fin
    if rd_ref0
        fileio:close(rd_ref0)
        rd_ref0 = 0
    fin
end
// srcrewind -- (re)open the top-level file; every pass starts here.
def srcrewind()#1
    srcclose()
    rd_ref0 = fileio:open(@srcpath)
    if not rd_ref0
        return 0
    fin
    rd_fill0 = 0
    rd_pos0 = 0
    rd_inputt = 0
    rd_pendput = 0
    g_lineno = 0
    g_putbase = 0
    g_putlines = 0
    return 1
end
// srcline -- the next logical line of the EXPANDED stream into
// linebuf; -1 at the end. Opens the pending put file first.
// srcslow -- the fast path missed: a pending PUT to open, a line that
// straddles the block (rdgetline copies and refills), a put file at
// its end, or the end of the source
def srcslow()#1
    word n
    if rd_pendput
        rd_pendput = 0
        rd_ref1 = fileio:open(@putpath)
        if not rd_ref1
            eputs("nas: PUT/USE: cannot open "); eputs(@putpath); eputln
            errflag = 1
            return -1
        fin
        rd_fill1 = 0
        rd_pos1 = 0
        rd_inputt = 6
        g_putbase = g_lineno
    fin
    if rd_inputt
        n = rdgetline(1)
        if n >= 0
            g_lineno++
            rd_linelen = n
            return n
        fin
        g_putlines = g_putlines + g_lineno - g_putbase
        fileio:close(rd_ref1)
        rd_ref1 = 0
        rd_inputt = 0
    fin
    n = rdgetline(0)
    if n >= 0
        g_lineno++
        rd_linelen = n
    fin
    return n
end
// rdnoteput -- called only for a classified TOP-LEVEL PUT/USE line;
// its fully parsed operand arms the splice for the next reader call.
def rdnoteput()#0
    if isputline()
        buildputpath(g_operptr, g_operlen)
        rd_pendput = 1
        rd_inputt = 12                 // the empty slot: srcslow next
    fin
end
//
// ---- pass1 -- locate: tokenize, size, and enter labels -----------------
// One walk of the stream; per CODE line an opcode byte is appended;
// EQU lines that evaluated unresolved or tainted (g_prov) go on the
// retry list, ERR lines on the deferred list. Same dispatch, same
// directive rules as the table-backed pass 1 (every rule's measured
// provenance is in the git history of this file).
//
// EQU forward-reference retry (AS-PLASMA.md sec 6, the EQU-forward
// silent-miscompile hazard, `01M05519PC55WGJNE4PY5HX4TH`): measured
// against merlin32 directly -- a 2-hop forward EQU chain (`A equ
// B+1` / `B equ 5`, A before B) resolves CORRECTLY in merlin32 (A=6).
// So every EQU that could still change -- unresolved, or read a
// provisional symbol -- is re-evaluated in a bounded fixed-point loop
// after the walk, with its own captured `*` and zone. An EQU that
// forward-references a CODE LABEL resolves there too once the label
// has its address.
//
def loopservice(d)#0
    word ok
    if d == 100 or d == 101
        $10=>[26], ok = evalexpr($10=>[27], $10=>[28])
        $10=>[39] = 0
        if relflag
            $10=>[39] = g_ek
        fin
        $10=>[40] = g_ern
        $10=>[38] = g_eraw
        $10=>[41] = g_esel
        if d == 100
            if not ok
                $10=>[39] = 1
            fin
            $10=>[42] = 2
        else
            $10=>[42] = 3
        fin
    elsif d == 107
        newmodepage()
        $10=>[42] = 4
    elsif d == 108
        nextmodepage()
        $10=>[42] = 1
    elsif d == 102
        outflush()
        $10=>[42] = 3
    else
        if d == 104
            eputs("nas: phase error: mode stream line ")
        elsif d == 105
            eputs("nas: branch out of range line ")
        elsif d == 106
            eputs("nas: fixup table full line ")
        fin
        if d <> 103
            eputi(g_lineno); eputln
        fin
        errflag = 1
    fin
end
def pass1#0
    word len
    byte c
    word cnt, ok
    word iter, changed, i2, idx, rp, d
    numlines = 0
    numsyms  = 0
    curpc    = 0
    orgset   = 0
    errflag  = 0
    xcflag   = 0
    relflag  = 0
    numexts  = 0
    numents  = 0
    nfixcand = 0
    numfixups = 0
    dumflag  = 0
    dumsave  = 0
    dumabs   = 0
    modecnt  = 0
    numretry = 0
    numerrs  = 0
    errfill  = 0
    curzone = 0
    g_chk = 0
    g_eqbad = 0
    g_nunk = 0
    if not srcrewind()
        errflag = 1
        return
    fin
    $10=>[42] = 0
    while not errflag
        d = fastloop($10, 1)
        if d == -2
            len = srcslow()
            if len < 0
                break
            fin
            d = lineprep(0, @g_line, @g_labelptr, @dirhash)
        fin
        if d == D_PUT and not rd_inputt
            rdnoteput()
        fin
        if d >= 100
            loopservice(d)
            continue
        fin
        if d < 0
            continue
        fin
        if g_labellen and ^g_labelptr <> ':'
            curzone++
        fin
        curstar = curpc
        if g_mnemlen == 0
            if g_labellen
                deflabel(curpc)
            fin
        elsif d == D_CODE
            if g_labellen
                deflabel(curpc)
            fin
            $10=>[42] = 1
        elsif d == D_DFB
            if g_labellen
                deflabel(curpc)
            fin
            cnt = listwalk(g_operptr, g_operlen, 0, LK_DFB)
            curpc = curpc + cnt
            nfixcand = nfixcand + cnt      // `dfb <LABEL`: a 1-byte fixup per item
        elsif d == D_DA
            if g_labellen
                deflabel(curpc)
            fin
            cnt = listwalk(g_operptr, g_operlen, 0, LK_DA)
            curpc = curpc + cnt
            nfixcand = nfixcand + cnt / 2   // one possible fixup per item
        elsif d == D_DS
            if g_labellen
                deflabel(curpc)
            fin
            cnt, ok = evalexpr(g_operptr, g_operlen)
            if not ok
                // an UNRESOLVED ds operand (undefined symbol, or a
                // forward reference -- merlin32 rejects both) sizes
                // addresses in pass 1, so there is no retry for it
                errflag = 1
                eputs("nas: ds operand unresolved\n")
                cnt = 0
            fin
            if cnt < 0
                errflag = 1   // merlin32 v1.1.10 REJECTS a negative DS
                cnt = 0
            fin
            curpc = curpc + cnt
        elsif d == D_ASC
            if g_labellen
                deflabel(curpc)
            fin
            cnt = listwalk(g_operptr, g_operlen, 0, LK_ASC)
            curpc = curpc + cnt
        elsif d == D_EQU
            g_prov = 0
            cnt, ok = evalexpr(g_operptr, g_operlen)
            idx = 0
            if g_labellen
                deflabel(cnt)
                idx = findsym(g_labelptr, g_labellen)
                if idx
                    ^(idx + 8) = ^(idx + 8) | F_EQU
                fin
            fin
            if not ok or g_prov
                pushretry(idx, curstar, curzone, g_operptr, g_operlen)
            fin
        elsif d == D_HEX
            if g_labellen
                deflabel(curpc)
            fin
            cnt = sizehex(g_operptr, g_operlen)
            curpc = curpc + cnt
        elsif d == D_STR
            if g_labellen
                deflabel(curpc)
            fin
            cnt = 1 + listwalk(g_operptr, g_operlen, 0, LK_ASC)
            curpc = curpc + cnt
        elsif d == D_DCI
            if g_labellen
                deflabel(curpc)
            fin
            cnt = listwalk(g_operptr, g_operlen, 0, LK_ASC)
            curpc = curpc + cnt
        elsif d == D_DDB
            if g_labellen
                deflabel(curpc)
            fin
            cnt = listwalk(g_operptr, g_operlen, 0, LK_DDB)
            curpc = curpc + cnt
        elsif d == D_ORG
            curpc = evalexprval(g_operptr, g_operlen)
            curstar = curpc
            if not orgset
                orgbase = curpc
                orgset  = 1
            fin
        elsif d == D_DUM
            // EXPR is evaluated BEFORE curpc is overwritten, so a
            // `dum *` idiom (liba/libabss.s) resolves `*` to the REAL
            // pc as it stood here, not to the about-to-be-set DUM pc.
            cnt = evalexprval(g_operptr, g_operlen)
            dumabs = 0
            if relflag
                dumabs = g_ek == 0
            fin
            dumsave = curpc
            curpc = cnt
            curstar = curpc
            dumflag = 1
        elsif d == D_DEND
            curpc = dumsave
            curstar = curpc
            dumflag = 0
        elsif d == D_ERR
            // deferred: EXPR may reference a label/EQU whose final
            // value only settles after the EQU retry (pwd.s's `err
            // */$BF00` sits INSIDE its own dum block -- its own
            // curstar/curzone travel with it).
            pusherr(curstar, curzone, g_operptr, g_operlen)
        elsif d == D_XC
            xcflag = 1
        elsif d == D_LST
            // listing directive -- no object-file effect
        elsif d == D_TR
            // listing-truncate directive -- byte-inert (see dirTR)
        elsif d == D_EXP
            // macro-expansion listing directive -- byte-inert
        elsif d == D_DSK
            // output-filename directive -- nas always takes `-o`
        elsif d == D_TYP
            // ProDOS file-type directive -- byte-inert (see dirTYP)
        elsif d == D_REL
            relflag = 1        // emits nothing; must precede any label
        elsif d == D_ENT
            if g_labellen
                deflabel(curpc)
                idx = findsym(g_labelptr, g_labellen)
                if idx
                    ^(idx + 8) = ^(idx + 8) | F_ENT
                    numents++
                fin
            fin
        elsif d == D_EXT
            if g_labellen
                idx = findsym(g_labelptr, g_labellen)
                if idx == 0
                    idx = addsym(g_labelptr, g_labellen, 0, 1)
                fin
                if not idx
                    break
                fin
                ^(idx + 8) = ^(idx + 8) | F_EXT
                *(idx + 2) = numexts     // the refnum
                numexts++
            fin
        elsif d == D_PUT
            // the reader splices the file after this line; the line
            // itself sizes to zero, as merlin32's listing shows it
        fin
        // Inside a DUM block a label is bound to the DUM-relative pc
        // (every line still advances it) and emits nothing in pass 2;
        // a constant-origin DUM's labels are absolute cells, not
        // fixups (dumabs, the $FF00-page case).
        if dumflag and dumabs and g_labellen
            idx = findsym(g_labelptr, g_labellen)
            if idx
                ^(idx + 8) = ^(idx + 8) | F_EQU
            fin
        fin
        numlines++
    loop
    srcclose()
    if errflag
        return
    fin
    objhigh = curpc - orgbase
    //
    // EQU retry fixed point over the list (bounded: a chain is at
    // most numretry deep).
    //
    iter = 0
    changed = 1
    while changed and iter <= numretry
        changed = 0
        i2 = 0
        rp = retry
        while i2 < numretry
            curstar = *(rp + 2)
            curzone = *(rp + 4)
            cnt, ok = evalexpr(rp + 7, ^(rp + 6))
            if not ok
                g_eqbad = 1
            fin
            idx = *rp
            if idx and *(idx + 2) <> cnt
                *(idx + 2) = cnt
                changed = 1
            fin
            rp = *(rp - 2)
            i2++
        loop
        iter++
    loop
    i2 = 0
    rp = retry
    while i2 < numretry
        idx = *rp
        if idx
            ^(idx + 8) = ^(idx + 8) & ~F_PROV
        fin
        rp = *(rp - 2)
        i2++
    loop
    //
    // Deferred ERR check -- after the EQU retry, mirroring merlin32's
    // own "Check for Err lines" step. Trigger is NONZERO (merlin32
    // v1.1.10 fails `err -1` exactly like `err 1`; only `err 0` passes).
    //
    rp = errlist
    i2 = 0
    while i2 < numerrs
        curstar = *rp
        curzone = *(rp + 2)
        cnt = evalexprval(rp + 5, ^(rp + 4))
        if cnt <> 0
            errflag = 1
        fin
        rp = *(rp - 2)
        i2++
    loop
end
//
// ---- pass2 -- emit ------------------------------------------------------
// The stream again: parse, size with the SAME directive rules, take
// each code line's mode from the stream, commit instructions directly
// to outbuf, and stage directive bytes in linebytes. Every label is a PHASE
// CHECK (its pass-1 value must equal the counter here); the final
// counter must equal pass 1's. A mismatch names the line and fails.
//
def phasecheck()#0
    word idx
    if g_labellen == 0
        return
    fin
    idx = findsym(g_labelptr, g_labellen)
    if idx == 0 or *(idx + 2) <> curpc
        if not errflag
            eputs("nas: phase error line "); eputi(g_lineno); eputln
        fin
        errflag = 1
    fin
end
def pass2#0
    word len, v, sz, n, cnt, op, mode
    word d, ok
    byte c
    curpc   = 0
    orgset  = 0
    dumflag = 0
    dumsave = 0
    modepos = 0
    curzone = 0
    g_chk = 1
    if not srcrewind()
        errflag = 1
        return
    fin
    $10=>[42] = 0
    while not errflag
        d = fastloop($10, 2)
        if d == -2
            len = srcslow()
            if len < 0
                break
            fin
            d = lineprep(0, @g_line, @g_labelptr, @dirhash)
        fin
        if d == D_PUT and not rd_inputt
            rdnoteput()
        fin
        if d >= 100
            loopservice(d)
            continue
        fin
        if d < 0
            continue
        fin
        if g_labellen and ^g_labelptr <> ':'
            curzone++
        fin
        curstar = curpc
        if g_mnemlen == 0
            phasecheck()
        elsif d == D_CODE
            if g_labellen
                phasecheck()
            fin
            $10=>[42] = 1
        elsif d == D_DFB
            phasecheck()
            if dumflag
                cnt = listwalk(g_operptr, g_operlen, 0, LK_DFB)
            else
                cnt = listwalk(g_operptr, g_operlen, linebytes, LK_DFB)
                outwrite(linebytes, cnt)
            fin
            curpc = curpc + cnt
        elsif d == D_DA
            phasecheck()
            if dumflag
                cnt = listwalk(g_operptr, g_operlen, 0, LK_DA)
            else
                cnt = listwalk(g_operptr, g_operlen, linebytes, LK_DA)
                outwrite(linebytes, cnt)
            fin
            curpc = curpc + cnt
        elsif d == D_DS
            phasecheck()
            cnt = evalexprval(g_operptr, g_operlen)
            if cnt < 0
                cnt = 0
            fin
            if not dumflag
                outzeros(cnt)
            fin
            curpc = curpc + cnt
        elsif d == D_ASC
            phasecheck()
            if dumflag
                cnt = listwalk(g_operptr, g_operlen, 0, LK_ASC)
            else
                cnt = listwalk(g_operptr, g_operlen, linebytes, LK_ASC)
                outwrite(linebytes, cnt)
            fin
            curpc = curpc + cnt
        elsif d == D_EQU
            // final value already in the table; emits nothing. Only
            // an EQU the retry found unresolved is evaluated again,
            // here, so the report can name its file and line.
            if g_eqbad
                cnt, ok = evalexpr(g_operptr, g_operlen)
            fin
        elsif d == D_HEX
            phasecheck()
            if dumflag
                cnt = sizehex(g_operptr, g_operlen)
            else
                cnt = emithex(g_operptr, g_operlen, linebytes)
                outwrite(linebytes, cnt)
            fin
            curpc = curpc + cnt
        elsif d == D_STR
            phasecheck()
            if dumflag
                n = listwalk(g_operptr, g_operlen, 0, LK_ASC)
            else
                n = listwalk(g_operptr, g_operlen, linebytes + 1, LK_ASC)
                ^linebytes = n & $FF
                outwrite(linebytes, n + 1)
            fin
            curpc = curpc + n + 1
        elsif d == D_DCI
            phasecheck()
            if dumflag
                cnt = listwalk(g_operptr, g_operlen, 0, LK_ASC)
            else
                cnt = listwalk(g_operptr, g_operlen, linebytes, LK_ASC)
                if cnt > 0
                    ^(linebytes + cnt - 1) = ^(linebytes + cnt - 1) ^ $80
                fin
                outwrite(linebytes, cnt)
            fin
            curpc = curpc + cnt
        elsif d == D_DDB
            phasecheck()
            if dumflag
                cnt = listwalk(g_operptr, g_operlen, 0, LK_DDB)
            else
                cnt = listwalk(g_operptr, g_operlen, linebytes, LK_DDB)
                outwrite(linebytes, cnt)
            fin
            curpc = curpc + cnt
        elsif d == D_ORG
            v = evalexprval(g_operptr, g_operlen)
            if orgset and not dumflag
                if isult(v, curpc)
                    eputs("nas: backward org line "); eputi(g_lineno); eputln
                    errflag = 1
                else
                    outzeros(v - curpc)
                fin
            fin
            orgset = 1
            curpc = v
            curstar = curpc
        elsif d == D_DUM
            cnt = evalexprval(g_operptr, g_operlen)
            dumsave = curpc
            curpc = cnt
            curstar = curpc
            dumflag = 1
        elsif d == D_DEND
            curpc = dumsave
            curstar = curpc
            dumflag = 0
        elsif d == D_ERR
            // pass 1 deferred the test itself; an unknown label in
            // the expression is reported here, at its own line
            cnt = evalexprval(g_operptr, g_operlen)
        elsif d == D_XC
            xcflag = 1
        elsif d == D_LST
        elsif d == D_TR
        elsif d == D_EXP
        elsif d == D_DSK
        elsif d == D_TYP
        elsif d == D_REL
        elsif d == D_ENT
            phasecheck()
        elsif d == D_EXT
        elsif d == D_PUT
        fin
    loop
    srcclose()
    if g_nunk
        errflag = 1
    fin
    if not errflag and (modepos <> modecnt or *modepage)
        eputs("nas: phase error: code line count\n")
        errflag = 1
    fin
    if not errflag and curpc - orgbase <> objhigh
        eputs("nas: phase error: final counter\n")
        errflag = 1
    fin
end
//
// ---- driver ---------------------------------------------------------
//
def run#1
    word arg, lc, sc, lo, cl, hi
    initloop(@loopseed)

    // optab and its hash chains, block ends, mode maps and opmode
    // are static source data; no per-invocation table construction.

    // the command line starts with the program's own name, as on a
    // stock PLASMA system (rt.pla buildcmdln); plasm does the same
    arg = argNext(argFirst)
    if not ^arg
        eputs("usage: nas [-o obj] src\n")
        return 1
    fin
    if ^arg == 2 and ^(arg+1) == '-' and toup(^(arg+2)) == 'O'
        arg = argNext(arg)
        if not ^arg
            eputs("nas: -o requires an argument\n")
            return 1
        fin
        strcpy(@objpath, arg)
        arg = argNext(arg)
        if not ^arg
            eputs("nas: missing source file\n")
            return 1
        fin
        strcpy(@srcpath, arg)
    else
        strcpy(@srcpath, arg)
        strcpy(@objpath, "A.OUT")
    fin

    // the reader's and writer's buffers: 2 x 512 read, 256 line,
    // 256 line-emission, 512 write -- the whole per-unit fixed cost
    rd_ref0 = 0
    rd_ref1 = 0
    outopen = 0
    errflag = 0
    rd_buf0   = xalloc(RDBUFSZ)
    rd_buf1   = xalloc(RDBUFSZ)
    linebuf   = xalloc(LINEMAX)
    linebytes = xalloc(LINEMAX)
    outbuf    = xalloc(OUTBUFSZ)
    if errflag
        return 1
    fin

    symrec = 0
    symtail = 0
    lochead = 0
    locmask = HASHSIZE - 1
    numlocs = 0
    modehead = 0
    modepage = 0
    errlist = 0
    errtail = 0
    newmodepage()
    retry = 0
    retrytail = 0
    hashhead = xalloc(HASHSIZE * 2)
    if errflag
        return 1
    fin
    hi = 0
    while hi < HASHSIZE
        hashhead=>[hi] = 0
        hi++
    loop

    pass1()
    if errflag
        eputs("nas: pass 1 failed\n")
        return 1
    fin

    // addfixup() is ONLY ever called from pass2 (REL emission), so
    // fxrec is sized after pass1 has counted the candidates: one
    // record array in file layout plus its $00 terminator.
    maxfixups  = relflag ?? nfixcand :: 1
    fxrec      = xalloc(maxfixups * 4 + 1)
    if errflag
        return 1
    fin

    if not outopenfile()
        eputs("nas: cannot write "); eputs(@objpath); eputln
        return 1
    fin
    *(modepage + 2) = modecnt
    modepage = modehead
    modestrm = modepage + 4
    modecnt = *(modepage + 2)
    pass2()
    if errflag
        outabort()
        eputs("nas: pass 2 failed\n")
        return 1
    fin
    if not outfinish()
        outabort()
        eputs("nas: cannot write "); eputs(@objpath); eputln
        return 1
    fin
    puts("nas: "); puti(outtotal); puts(" bytes -> "); puts(@objpath); putln
    return 0
end

return run()
done
