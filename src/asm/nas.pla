//
// Directive name literals (exact-length, case-insensitive match).
//
byte dirEQU[] = 'E','Q','U'
byte dirORG[] = 'O','R','G'
byte dirDS[]  = 'D','S'
byte dirDFB[] = 'D','F','B'
byte dirDB[]  = 'D','B'
byte dirASC[] = 'A','S','C'
byte dirHEX[] = 'H','E','X'
byte dirDCI[] = 'D','C','I'
byte dirSTR[] = 'S','T','R'
byte dirDA[]  = 'D','A'
byte dirDW[]  = 'D','W'
byte dirDDB[] = 'D','D','B'
byte dirLST[] = 'L','S','T'
byte dirXC[]  = 'X','C'
//
// TR (listing-truncate ON/OFF) and EXP (macro-expansion listing
// ON/OFF/ONLY) are Merlin LISTING directives -- byte-inert, like LST.
// gen_rel_module.py emits ` tr` and ` exp off` at the head of every
// generated liba REL form (S9 REL route) for listing parity with the
// real-Merlin reference build; the object bytes are identical either
// way (comments/listing emit nothing). nas must accept-and-ignore
// them, not fall through to the opcode path and error (measured
// 2026-09-13: without these, nas errors on the liba REL forms at the
// ` tr` line). Neither collides with an opcode: `tr` (2 chars) does
// not match TRB (nas compares three chars), and there is no `exp`
// opcode.
//
byte dirTR[]  = 'T','R'
byte dirEXP[] = 'E','X','P'
//
// L1b directives (docs/AS-PLASMA.md L1b bullet): REL/ENT/EXT switch
// nas into relocatable-object emission; PUT/USE are no-ops HERE --
// splicing happens in a pre-pass (expandsource, below) before pass1
// ever runs, so by the time pass1 sees a PUT/USE line it is only
// ever the marker line itself (kept verbatim in the expanded text,
// exactly as merlin32's own listing keeps it as a zero-size
// Directive line -- MEASURED, sec below) and must size to zero, not
// error as an unrecognized opcode.
//
byte dirREL[] = 'R','E','L'
byte dirENT[] = 'E','N','T'
byte dirEXT[] = 'E','X','T'
byte dirPUT[] = 'P','U','T'
byte dirUSE[] = 'U','S','E'
//
// L2 directives (docs/AS-PLASMA.md sec 6, task #21 gap-closure batch).
// DUM/DEND bracket a dummy/bss section (location counter jumps to
// DUM's operand, DEND restores the REAL pc saved at DUM time -- see
// dumflag/dumsave below and pass1's dispatch); ERR is an assembly-
// time assertion (nonzero EXPR fails the assembly, checked once ALL
// labels/EQUs are settled -- see the deferred T_ERR walk after the
// EQU forward-reference retry); DSK only names merlin32's own default
// output file and does not affect object bytes -- nas always takes
// `-o`, so DSK is parsed and ignored (MEASURED against merlin32
// v1.1.10: a DSK line changes ONLY the oracle's chosen filename, byte-
// identical object either way -- task report).
//
byte dirDUM[]  = 'D','U','M'
byte dirDEND[] = 'D','E','N','D'
byte dirERR[]  = 'E','R','R'
byte dirDSK[]  = 'D','S','K'
//
// TYP -- NOT in docs/AS-PLASMA.md sec 6's directive-frequency table
// (an undocumented gap the architect's own frequency sweep missed),
// but found live in 53 top-level units (src/bin/pwd.s, as.s, and
// nearly every other unit's header: `dsk NAME / typ $00`, right after
// DSK). Same shape as DSK -- MEASURED against merlin32 v1.1.10: a
// `typ EXPR` line sets ONLY the oracle's own output file's ProDOS
// file-type byte and has ZERO effect on the emitted object bytes
// (probe: identical 3-byte object with and without a `typ $06` line).
// nas always takes `-o` and any real ProDOS typing happens later, in
// the Python staging scripts -- so TYP is parsed and ignored, exactly
// like DSK.
//
byte dirTYP[]  = 'T','Y','P'
//
// Symbol table: HEAP-backed parallel arrays (sec below) -- capacity is
// a prescan upper bound on the source, not an arbitrary constant.
// Lookup is a chained hash (hashhead/hashnext, below), not the linear
// scan this comment used to describe -- AS-PLASMA.md sec 3's hash-vs-
// scan question is resolved by measurement in docs/AS-PROFILE.md.
//
const NAMELEN = 14   // 1 length byte + up to 13 significant chars
//
// L3 S4 (docs/AS-STREAM.md sec 5, 2026-09-14): one PACKED record per
// symbol -- nameptr:2 value:2 zone:2 hashnext:2 flags:1 -- and the
// names in an arena as `len, chars` (never fixed-width). An EXT
// symbol keeps its refnum in the value field (its value reads as 0,
// evalterm2). 9 B + the name against the 27 B of ten parallel
// arrays: KLAZY's 470 symbols were 16.2 KB, now ~8.5.
//
const SYMRSZ = 9
const F_DEF  = 1
const F_EQU  = 2     // an EQU CONSTANT, never relocates (was symkind)
const F_EXT  = 4
const F_ENT  = 8
const F_PROV = 16    // value provisional (the EQU retry's taint)
