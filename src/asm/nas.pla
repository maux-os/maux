const D_STR  = 17
const D_DA   = 18
const D_DDB  = 19
const D_REL  = 20
const D_ENT  = 21
const D_EXT  = 22
const D_PUT  = 23
//
// Instruction size in bytes, indexed by mode (opcode byte + operand).
//
// The table itself follows opmode: noteinst reads the pair together.
//
// Per-line record "type" (what pass 2 must emit, if anything).
//
const T_NONE = 0
const T_CODE = 1
const T_DFB  = 2
const T_ASC  = 3
const T_DS   = 4
const T_HEX  = 5
const T_DCI  = 6
const T_STR  = 7
const T_DA   = 8
const T_DDB  = 9
const T_EQU  = 10   // bookkeeping only for the forward-EQU retry (sec below); emits nothing
const T_ERR  = 11   // bookkeeping only for the deferred ERR check (sec below); emits nothing
//
// listwalk/emititem "kind" -- numeric-list (DFB/DA/DDB, a quoted item
// contributes only its FIRST char's code) vs string-list (ASC/DCI/STR,
// a quoted item expands every character). Measured against merlin32:
// `dfb "AB",$00` -> C1 00 (only 'A'); `asc "AB",$00` -> C1 C2 00 (both).
//
const LK_DFB = 0
const LK_ASC = 1
const LK_DA  = 2
const LK_DDB = 3
//
// ---- opcode table -----------------------------------------------------
// 178 entries, generated by the architect's scratch script and
// verified against merlin32 v1.1.10 byte-for-byte (every NMOS
// mnemonic/mode and every 65C02 addition below was run through
// merlin32 -v1 and its object bytes read back). Row = mnemonic(3),
// mode, opcode byte, cmos-only-flag. Matched by (mnemonic first 3
// chars, mode) -- NOT a fixed per-mnemonic column matrix, because the
// 65C02 additions extend some NMOS mnemonics (INC/DEC gain ACC, BIT
// gains IMM/ZPX/ABSX, ADC/AND/CMP/EOR/LDA/ORA/SBC/STA gain IZP, JMP
// gains AINDX) with modes a fixed matrix would waste on 64 unused
// cells per new column.
//
const NOPTAB = 178
