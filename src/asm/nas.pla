    if numretry >= RETRYMAX
        if not errflag
            eputs("nas: too many forward equates\n")
        fin
        errflag = 1
        return
    fin
    if l > 65
        l = 65
    fin
    rp = xalloc(9 + l)
    if not rp
        return
    fin
    *rp = 0
    rp = rp + 2
    if retrytail
        *(retrytail - 2) = rp
    else
        retry = rp
    fin
    retrytail = rp
