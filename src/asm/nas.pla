end
def listwalk(p, l, dest, kind)#1
    word start, nx, n, sz
    n = 0
    start = 0
    if l == 0
        return 0
    fin
    // Sizing needs boundaries, not values or an emitter call. EQU
    // resets g_prov before evaluation; no expression effects escape.
    sz = (kind == LK_DA or kind == LK_DDB) ?? 2 :: 1
    while start <= l
        nx = itemscan(p, l, start)
