// Diagnostics go to fd 2 (stderr), one byte per write: failure paths
// only, so no buffer. Text is maux high-bit ASCII ($0D prints as $8D).
def eputc(c)#0
    byte b
    b = c | $80
    fileio:write(2, @b, 1)
end
def eputs(s)#0
    word i
    for i = 1 to ^s
        eputc(^(s + i))
    next
end
def eputi(n)#0
    if n < 0; eputc('-'); n = -n; fin
    if n >= 10; eputi(n / 10); fin
    eputc(n % 10 + '0')
end
def eputln()#0
    eputc(13)
end

def xalloc(n)#1
    word p
    p = 0
    if isule(n, heapavail())
        p = heapalloc(n)
    fin
    if not p
        if not errflag
            eputs("nas: out of memory\n")   // once per run, not per table
        fin
        errflag = 1
    fin
    return p
end
//
// Incremental, stable-address storage. No pass0 and no realloc/copy.
// Symbols have two extra bytes for declaration-order traversal, followed
// immediately by their counted name. Hash record offsets remain unchanged.
def newsymbol(l)#1
    word p
    p = xalloc(SYMRSZ + 3 + l)
    if not p
        return 0
    fin
    *(p + SYMRSZ) = 0
    if symtail
        *(symtail + SYMRSZ) = p
    else
        symrec = p
    fin
    symtail = p
    return p
end
// A replay page is next:2, used:2, payload:256. Boundary service is
// requested BEFORE noteinst changes PC/count, so allocation can fail safely.
def newmodepage()#0
    word p
    p = xalloc(260)
    if not p
        return
    fin
    *p = 0
    *(p + 2) = 0
    if modepage
        *(modepage + 2) = modecnt
        *modepage = p
    else
        modehead = p
    fin
    modepage = p
    modestrm = p + 4
    modecnt = 0
    maxmodes = 256
end
def nextmodepage()#0
    if modepos <> modecnt or not *modepage
        eputs("nas: phase error: mode stream line ")
        eputi(g_lineno); eputln
        errflag = 1
        return
    fin
    modepage = *modepage
    modestrm = modepage + 4
    modecnt = *(modepage + 2)
    modepos = 0
end

def toup(c)#1
    if c >= 'a' and c <= 'z'
        return c - 32
    fin
    return c
end
def ishexdig(c)#1
    c = toup(c)
    if (c >= '0' and c <= '9') or (c >= 'A' and c <= 'F')
        return 1
    fin
    return 0
end
def isnamechar(c)#1
    c = toup(c)
    if (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' or c == ':'
        return 1
    fin
    return 0
end
def hexval(p, l)#1
    word v, i
    byte c
    v = 0
    if l == 0
        return 0
    fin
    i = 0
    while i < l
        c = ^(p + i)
        if c >= '0' and c <= '9'
            v = (v << 4) + (c - '0')
        elsif c >= 'A' and c <= 'F'
            v = (v << 4) + (c - 'A' + 10)
        elsif c >= 'a' and c <= 'f'
            v = (v << 4) + (c - 'a' + 10)
        fin
        i++
    loop
    return v
end
// ---- :local zone-ambiguity index ------------------------------------
// Return a record pointer (0 = absent), comparing exactly the same
// clamped, raw-case bytes that hashname and the main symtab use.
//
def findloc(p, l)#1
    word i, namep
    if not lochead
        return 0
    fin
    if l > 13
        l = 13
    fin
    i = lochead=>[hashname(p, l) & locmask]
    while i
        namep = **i
        if ^namep == l
            if nameeq(p, namep + 1, l)
                return i
            fin
        fin
        i = *(i + 4)
    loop
    return 0
end
def addloc(slot, zone)#0
    word namep, h
    if not lochead
        lochead = xalloc(HASHSIZE * 2)
        if not lochead
            return
        fin
        h = 0
        while h < HASHSIZE
            lochead=>[h] = 0
            h++
        loop
    fin
    locnext = xalloc(6)
    if not locnext
        return
    fin
    namep = *slot
    h = hashname(namep + 1, ^namep) & locmask
    *locnext = slot
    *(locnext + 2) = zone
    *(locnext + 4) = lochead=>[h]
    lochead=>[h] = locnext
    numlocs++
end
// islocalambig -- 0 if `p,l` (a `:name` span, colon included) was
// defined in at most one zone file-wide (or never recorded at all --
// a REFERENCE with no matching definition falls back to the same
// zone-agnostic wildcard nas already uses for an undefined symbol).
//
def islocalambig(p, l)#1
    word idx
    idx = findloc(p, l)
    if not idx
        return 0
    fin
    return *(*idx + 4) <> -1
end
// reszone -- the query/store zone for a findsym/addsym span. Global
// names (no leading `:`) and unambiguous locals are ZONE-AGNOSTIC
// (-1, the wildcard that matches from any zone -- merlin32's "whole-
// file uniqueness" case, and today's plain global behavior for every
// non-local symbol). An AMBIGUOUS local (the SAME `:name` defined in
// more than one zone) is zone-SPECIFIC: its query/store zone is
// curzone, the CURRENT line's zone (pass1 and pass2 number global
// labels identically while streaming the source).
//
def reszone(p, l)#1
    if l == 0
        return -1
    fin
    if ^p <> ':'
        return -1
    fin
    if islocalambig(p, l)
        return curzone
    fin
    return -1
end
// Symbol lookup returns a record POINTER (0 = absent), not the old
// signed slot index. The native findsymh walks pointer-linked records
// and accepts only the current query zone or a record's $FFFF zone.
def findsym(p, l)#1
    if l > 13
        l = 13
    fin
    return findsymh(p, l, hashhead=>[hashname(p, l)], curzone)
end
def addsymh(p, l, val, isdef, h)#1
    word namep, zone, rp
    zone = reszone(p, l)
    rp = newsymbol(l)
    if not rp
        return 0
    fin
    namep = rp + SYMRSZ + 2
    ^namep = l
    memcpy(namep + 1, p, l)
    *rp = namep
    *(rp + 2) = val
    *(rp + 4) = zone
    *(rp + 6) = hashhead=>[h]
    ^(rp + 8) = isdef ?? F_DEF :: 0
    hashhead=>[h] = rp
    numsyms++
    return rp
end
def addsym(p, l, val, isdef)#1
    if l > 13
        l = 13
    fin
    return addsymh(p, l, val, isdef, hashname(p, l))
end
def setsym(p, l, val)#0
    word idx, h
    if l > 13
        l = 13
    fin
    h = hashname(p, l)                 // ONE hash: lookup, then insert
    idx = findsymh(p, l, hashhead=>[h], curzone)
    if idx == 0
        addsymh(p, l, val, 1, h)
    else
        *(idx + 2) = val
        ^(idx + 8) = ^(idx + 8) | F_DEF
    fin
end
