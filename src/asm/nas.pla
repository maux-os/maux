def outflush()#0
    word n
    if outfill
        n = fileio:write(outref, outbuf, outfill)
        if n <> outfill
            if not errflag
                eputs("nas: write failed\n")
            fin
            errflag = 1
        fin
        outfill = 0
    fin
end
def outwrite(p, n)#0
    if outfill + n > OUTBUFSZ          // n <= a line (256) < OUTBUFSZ
        outflush()
    fin
    memcpy(outbuf + outfill, p, n)
    outfill = outfill + n
    outtotal = outtotal + n
end
