    byte hi
    if isquoteitem(p, l)
        hi = (^p == '"') ?? $80 :: 0
        if kind == LK_DFB
            v = ^(p+1) | hi
            ^dest = v & $FF
            return 1
        elsif kind == LK_DA or kind == LK_DDB
            v = ^(p+1) | hi
            if kind == LK_DA
                ^dest = v & $FF
                ^(dest+1) = (v >> 8) & $FF
            else
                ^dest = (v >> 8) & $FF
                ^(dest+1) = v & $FF
            fin
            return 2
        else
            i = 1
            while i < l - 1
                ^(dest + i - 1) = ^(p+i) | hi
                i++
            loop
            return l - 2
        fin
    else
